# Copy to /etc/quant-india/env on a VPS. Never commit real values.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=REPLACE_ME
DUCKDB_PATH=/opt/quant-india/data/quant_india.duckdb
QUANT_INDIA_STATUS_FILE=/opt/quant-india/var/operational_status.json
PORT=8080
# Optional, operator-owned command (for example an approved Supabase CLI workflow).
# SUPABASE_BACKUP_COMMAND=

# Phase 3 configuration
SYSTEM_MODE=LOCAL  # LOCAL, PAPER, or VPS
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# v0.4 broker sandbox layer (LIVE is always disabled — see docs/broker_integration.md)
QUANT_EXECUTION_MODE=PAPER  # Daily runner accepts PAPER only; LIVE is refused
QUANT_BROKER_STATUS_FILE=/opt/quant-india/var/broker_status.json
# Optional: broker OAuth secrets (never commit real values).
# The local Paper Dashboard consumes only the short-lived access-token variables
# below to READ market data. It has no live-order endpoint.
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
# UPSTOX_REDIRECT_URI=http://localhost:8080
# UPSTOX_ACCESS_TOKEN=                 # daily OAuth token: quote data only
# UPSTOX_SANDBOX_ACCESS_TOKEN=         # optional Upstox Sandbox quote token
# QUANT_PAPER_DB=var/paper_trading.sqlite
# QUANT_PAPER_QUOTE_REFRESH_SECONDS=30
# DHAN_CLIENT_ID=
# DHAN_API_SECRET=
