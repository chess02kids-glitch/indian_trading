[Unit]
Description=Indian Trading DB Backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=appuser
WorkingDirectory=/opt/indian_trading
Environment=PYTHONPATH=/opt/indian_trading
EnvironmentFile=/opt/indian_trading/.env
ExecStart=/opt/indian_trading/venv/bin/python /opt/indian_trading/scripts/backup_db.py
