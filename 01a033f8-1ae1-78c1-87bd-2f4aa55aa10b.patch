+"""Tests for provider retries, normalization, and structured logging."""
+
+from __future__ import annotations
+
+import json
+import logging
+import sys
+from datetime import UTC, date, datetime
+from io import StringIO
+
+import pandas as pd
+import pytest
+
+from config.settings import LoggingConfig
+from ingestion.errors import NormalizationError, ProviderError
+from ingestion.normalization import CANONICAL_COLUMNS, normalize_market_data
+from ingestion.provider import YFinanceProvider
+from ingestion.structured_logging import (
+    JsonLogFormatter,
+    configure_logging,
+    contextual_logger,
+)
+
+
+def test_normalize_market_data_preserves_metadata_and_does_not_mutate(raw_frame) -> None:
+    """Provider columns become canonical columns with auditable metadata."""
+    original_columns = raw_frame.columns
+    ingested_at = datetime(2024, 1, 3, 12, tzinfo=UTC)
+    normalized = normalize_market_data(
+        raw_frame,
+        symbol="abc",
+        exchange="nse",
+        ingestion_timestamp=ingested_at,
+    )
+    assert tuple(normalized.columns) == CANONICAL_COLUMNS
+    assert normalized["symbol"].unique().tolist() == ["ABC"]
+    assert normalized["exchange"].unique().tolist() == ["NSE"]
+    assert normalized["source"].unique().tolist() == ["yfinance"]
+    assert normalized["adjustment_status"].unique().tolist() == ["unadjusted"]
+    assert normalized["source_timestamp"].dt.tz is not None
+    assert normalized["ingestion_timestamp"].iloc[0].to_pydatetime() == ingested_at
+    assert raw_frame.columns.equals(original_columns)
+
+
+def test_normalize_market_data_handles_yfinance_multiindex() -> None:
+    """The common one-ticker yfinance MultiIndex response is supported."""
+    columns = pd.MultiIndex.from_tuples(
+        [
+            ("Open", "ABC.NS"),
+            ("High", "ABC.NS"),
+            ("Low", "ABC.NS"),
+            ("Close", "ABC.NS"),
+            ("Volume", "ABC.NS"),
+        ]
+    )
+    raw = pd.DataFrame(
+        [[10, 12, 9, 11, 100]], columns=columns, index=pd.to_datetime(["2024-01-02"])
+    )
+    normalized = normalize_market_data(raw, "ABC", "NSE")
+    assert normalized.loc[0, "close"] == 11
+    assert pd.isna(normalized.loc[0, "adj_close"])
+
+
+def test_normalize_market_data_rejects_missing_columns(raw_frame) -> None:
+    """Missing required OHLCV fields fail before persistence."""
+    with pytest.raises(NormalizationError, match="required columns"):
+        normalize_market_data(raw_frame.drop(columns=["Volume"]), "ABC", "NSE")
+
+
+def test_yfinance_provider_downloads_inclusive_range() -> None:
+    """The adapter translates an inclusive end date for yfinance."""
+    calls: list[dict[str, object]] = []
+
+    def downloader(**kwargs):
+        calls.append(kwargs)
+        return pd.DataFrame({"Close": [1]}, index=pd.to_datetime(["2024-01-02"]))
+
+    provider = YFinanceProvider(max_attempts=1, downloader=downloader)
+    result = provider.download_history("ABC.NS", date(2024, 1, 2), date(2024, 1, 3))
+    assert len(result) == 1
+    assert calls[0]["start"] == "2024-01-02"
+    assert calls[0]["end"] == "2024-01-04"
+    assert calls[0]["auto_adjust"] is False
+
+
+def test_yfinance_provider_retries_and_applies_backoff() -> None:
+    """Transient provider exceptions are retried with exponential delays."""
+    attempts = 0
+    delays: list[float] = []
+
+    def downloader(**kwargs):
+        nonlocal attempts
+        attempts += 1
+        if attempts < 3:
+            raise RuntimeError("temporary provider failure")
+        return pd.DataFrame({"Close": [1]}, index=pd.to_datetime(["2024-01-02"]))
+
+    provider = YFinanceProvider(
+        max_attempts=3,
+        retry_backoff_seconds=0.25,
+        downloader=downloader,
+        sleeper=delays.append,
+    )
+    provider.download_history("ABC.NS", date(2024, 1, 2), date(2024, 1, 2))
+    assert attempts == 3
+    assert delays == [0.25, 0.5]
+
+
+def test_yfinance_provider_reports_exhausted_failures() -> None:
+    """Exhausted retries raise a provider-specific error."""
+
+    def downloader(**kwargs):
+        raise RuntimeError("provider offline")
+
+    provider = YFinanceProvider(max_attempts=2, retry_backoff_seconds=0, downloader=downloader)
+    with pytest.raises(ProviderError, match="after 2 attempt"):
+        provider.download_history("ABC.NS", date(2024, 1, 2), date(2024, 1, 2))
+
+
+def test_json_logging_contains_required_context() -> None:
+    """JSON logs carry timestamps, severity, module, and operation context."""
+    stream = StringIO()
+    logger = configure_logging(LoggingConfig(logger_name="quant-india-test"), stream)
+    contextual_logger(
+        logger,
+        symbol="ABC",
+        exchange="NSE",
+        source="yfinance",
+        operation="unit_test",
+    ).info("downloaded")
+    payload = json.loads(stream.getvalue())
+    assert payload["message"] == "downloaded"
+    assert payload["severity"] == "INFO"
+    assert payload["module"]
+    assert payload["symbol"] == "ABC"
+    assert payload["operation"] == "unit_test"
+    assert "timestamp" in payload
+
+
+def test_json_log_formatter_serializes_exception() -> None:
+    """Formatter output remains valid JSON when a record has an exception."""
+    record = logging.LogRecord(
+        "test", logging.ERROR, "/repo/structured_logging.py", 1, "failed", (), None
+    )
+    try:
+        raise RuntimeError("boom")
+    except RuntimeError:
+        record.exc_info = sys.exc_info()
+    payload = json.loads(JsonLogFormatter().format(record))
+    assert "RuntimeError: boom" in payload["exception"]
