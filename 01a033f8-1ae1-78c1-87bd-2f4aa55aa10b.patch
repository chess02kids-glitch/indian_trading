@@ -0,0 +1,459 @@
+"""Environment-aware configuration for the Quant India data foundation.
+
+The settings in this module describe data storage, the configured market
+universe, validation thresholds, logging, and the initial data provider. No
+credentials or broker-specific settings are accepted here. Values are immutable
+once loaded so ingestion components can safely share one configuration object.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import math
+import os
+import re
+from collections.abc import Mapping
+from dataclasses import dataclass
+from datetime import date
+from pathlib import Path
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+
+class ConfigurationError(ValueError):
+    """Raised when an environment or universe configuration is invalid."""
+
+
+SUPPORTED_EXCHANGES = ("NSE", "BSE")
+_EXCHANGE_SUFFIXES = {"NSE": ".NS", "BSE": ".BO"}
+_SYMBOL_PATTERN = re.compile(r"^[A-Z0-9][A-Z0-9._-]*$")
+
+
+def _required_text(value: object, field_name: str) -> str:
+    if not isinstance(value, str) or not value.strip():
+        raise ConfigurationError(f"{field_name} must be a non-empty string")
+    return value.strip()
+
+
+def _normalise_exchanges(values: tuple[str, ...] | list[str]) -> tuple[str, ...]:
+    exchanges = tuple(_required_text(value, "exchange").upper() for value in values)
+    if not exchanges:
+        raise ConfigurationError("supported_exchanges must contain at least one exchange")
+    if len(set(exchanges)) != len(exchanges):
+        raise ConfigurationError("supported_exchanges must not contain duplicates")
+    return exchanges
+
+
+@dataclass(frozen=True, slots=True)
+class UniverseEntry:
+    """One canonical instrument and its provider ticker symbol."""
+
+    symbol: str
+    exchange: str
+    provider_symbol: str | None = None
+
+    def __post_init__(self) -> None:
+        symbol = _required_text(self.symbol, "symbol").upper()
+        exchange = _required_text(self.exchange, "exchange").upper()
+        if not _SYMBOL_PATTERN.fullmatch(symbol):
+            raise ConfigurationError(
+                "symbol may contain only letters, numbers, periods, underscores, and hyphens"
+            )
+        provider_symbol = self.provider_symbol
+        if provider_symbol is not None:
+            provider_symbol = _required_text(provider_symbol, "provider_symbol")
+        object.__setattr__(self, "symbol", symbol)
+        object.__setattr__(self, "exchange", exchange)
+        object.__setattr__(self, "provider_symbol", provider_symbol)
+
+    @property
+    def ticker(self) -> str:
+        """Return the ticker understood by the configured market-data provider."""
+        if self.provider_symbol:
+            return self.provider_symbol
+        try:
+            suffix = _EXCHANGE_SUFFIXES[self.exchange]
+        except KeyError as exc:
+            raise ConfigurationError(
+                f"provider ticker is required for unsupported exchange {self.exchange!r}"
+            ) from exc
+        if self.symbol.endswith(suffix):
+            return self.symbol
+        return f"{self.symbol}{suffix}"
+
+    @classmethod
+    def from_mapping(cls, value: Mapping[str, object]) -> UniverseEntry:
+        """Build a universe entry from a JSON-compatible mapping."""
+        if not isinstance(value, Mapping):
+            raise ConfigurationError("each universe symbol must be an object")
+        try:
+            symbol = value["symbol"]
+            exchange = value["exchange"]
+        except KeyError as exc:
+            raise ConfigurationError(f"universe symbol is missing {exc.args[0]!r}") from exc
+        if not isinstance(symbol, str) or not isinstance(exchange, str):
+            raise ConfigurationError("symbol and exchange must be strings")
+        provider_symbol = value.get("provider_symbol")
+        if provider_symbol is not None and not isinstance(provider_symbol, str):
+            raise ConfigurationError("provider_symbol must be a string when supplied")
+        return cls(symbol=symbol, exchange=exchange, provider_symbol=provider_symbol)
+
+
+@dataclass(frozen=True, slots=True)
+class UniverseConfig:
+    """Configured instruments and the exchanges allowed by the deployment."""
+
+    symbols: tuple[UniverseEntry, ...] = ()
+    supported_exchanges: tuple[str, ...] = SUPPORTED_EXCHANGES
+
+    def __post_init__(self) -> None:
+        exchanges = _normalise_exchanges(tuple(self.supported_exchanges))
+        symbols = tuple(self.symbols)
+        if any(not isinstance(entry, UniverseEntry) for entry in symbols):
+            raise ConfigurationError("symbols must contain UniverseEntry values")
+        if any(entry.exchange not in exchanges for entry in symbols):
+            invalid = sorted(
+                {entry.exchange for entry in symbols if entry.exchange not in exchanges}
+            )
+            raise ConfigurationError(
+                f"universe contains exchanges that are not supported: {', '.join(invalid)}"
+            )
+        keys = [(entry.symbol, entry.exchange) for entry in symbols]
+        if len(set(keys)) != len(keys):
+            raise ConfigurationError("universe must not contain duplicate symbol/exchange pairs")
+        object.__setattr__(self, "symbols", symbols)
+        object.__setattr__(self, "supported_exchanges", exchanges)
+
+    @classmethod
+    def from_mapping(
+        cls,
+        value: Mapping[str, object],
+        supported_exchanges: tuple[str, ...] | None = None,
+    ) -> UniverseConfig:
+        """Build a universe configuration from a JSON-compatible mapping."""
+        if not isinstance(value, Mapping):
+            raise ConfigurationError("universe configuration must be an object")
+        raw_symbols = value.get("symbols", ())
+        if not isinstance(raw_symbols, list | tuple):
+            raise ConfigurationError("universe symbols must be an array")
+        entries = tuple(UniverseEntry.from_mapping(item) for item in raw_symbols)
+        configured_exchanges = supported_exchanges
+        if configured_exchanges is None:
+            raw_exchanges = value.get("supported_exchanges", SUPPORTED_EXCHANGES)
+            if not isinstance(raw_exchanges, list | tuple):
+                raise ConfigurationError("supported_exchanges must be an array")
+            if any(not isinstance(exchange, str) for exchange in raw_exchanges):
+                raise ConfigurationError("supported_exchanges must contain strings")
+            configured_exchanges = tuple(raw_exchanges)
+        return cls(symbols=entries, supported_exchanges=configured_exchanges)
+
+    @classmethod
+    def from_file(
+        cls,
+        path: Path | str,
+        supported_exchanges: tuple[str, ...] | None = None,
+    ) -> UniverseConfig:
+        """Load a universe configuration from a UTF-8 JSON file."""
+        path = Path(path).expanduser()
+        try:
+            payload = json.loads(path.read_text(encoding="utf-8"))
+        except FileNotFoundError as exc:
+            raise ConfigurationError(f"universe file does not exist: {path}") from exc
+        except json.JSONDecodeError as exc:
+            raise ConfigurationError(f"universe file is not valid JSON: {path}") from exc
+        return cls.from_mapping(payload, supported_exchanges=supported_exchanges)
+
+
+@dataclass(frozen=True, slots=True)
+class StorageConfig:
+    """Filesystem locations for raw Parquet and the DuckDB catalog."""
+
+    data_root: Path = Path("data")
+    raw_root: Path | None = None
+    clean_root: Path | None = None
+    features_root: Path | None = None
+    snapshots_root: Path | None = None
+    duckdb_path: Path | None = None
+
+    def __post_init__(self) -> None:
+        root = Path(self.data_root).expanduser()
+        raw_root = Path(self.raw_root).expanduser() if self.raw_root is not None else root / "raw"
+        clean_root = (
+            Path(self.clean_root).expanduser() if self.clean_root is not None else root / "clean"
+        )
+        features_root = (
+            Path(self.features_root).expanduser()
+            if self.features_root is not None
+            else root / "features"
+        )
+        snapshots_root = (
+            Path(self.snapshots_root).expanduser()
+            if self.snapshots_root is not None
+            else root / "snapshots"
+        )
+        duckdb_path = (
+            Path(self.duckdb_path).expanduser()
+            if self.duckdb_path is not None
+            else root / "quant_india.duckdb"
+        )
+        object.__setattr__(self, "data_root", root)
+        object.__setattr__(self, "raw_root", raw_root)
+        object.__setattr__(self, "clean_root", clean_root)
+        object.__setattr__(self, "features_root", features_root)
+        object.__setattr__(self, "snapshots_root", snapshots_root)
+        object.__setattr__(self, "duckdb_path", duckdb_path)
+
+
+@dataclass(frozen=True, slots=True)
+class ValidationConfig:
+    """Thresholds used by the market-data validation pipeline."""
+
+    stale_after_hours: float = 72.0
+    outlier_return_threshold: float = 0.20
+    outlier_window: int = 20
+    outlier_zscore: float = 6.0
+    holidays: tuple[date, ...] = ()
+
+    def __post_init__(self) -> None:
+        if not math.isfinite(self.stale_after_hours) or self.stale_after_hours <= 0:
+            raise ConfigurationError("stale_after_hours must be a finite number greater than zero")
+        if (
+            not math.isfinite(self.outlier_return_threshold)
+            or not 0 < self.outlier_return_threshold < 1
+        ):
+            raise ConfigurationError("outlier_return_threshold must be between zero and one")
+        if self.outlier_window < 2:
+            raise ConfigurationError("outlier_window must be at least two")
+        if not math.isfinite(self.outlier_zscore) or self.outlier_zscore <= 0:
+            raise ConfigurationError("outlier_zscore must be a finite number greater than zero")
+        holidays = tuple(self.holidays)
+        if any(not isinstance(value, date) for value in holidays):
+            raise ConfigurationError("holidays must contain date values")
+        object.__setattr__(self, "holidays", tuple(sorted(set(holidays))))
+
+
+@dataclass(frozen=True, slots=True)
+class LoggingConfig:
+    """Structured logging settings."""
+
+    level: str = "INFO"
+    json_output: bool = True
+    logger_name: str = "quant_india"
+
+    def __post_init__(self) -> None:
+        level = _required_text(self.level, "level").upper()
+        if not isinstance(logging.getLevelNamesMapping().get(level), int):
+            raise ConfigurationError(f"unknown logging level: {level}")
+        object.__setattr__(self, "level", level)
+        object.__setattr__(self, "logger_name", _required_text(self.logger_name, "logger_name"))
+
+
+@dataclass(frozen=True, slots=True)
+class IngestionConfig:
+    """Provider and retry settings for historical ingestion."""
+
+    source: str = "yfinance"
+    max_attempts: int = 3
+    retry_backoff_seconds: float = 1.0
+    timeout_seconds: float = 30.0
+    auto_adjust: bool = False
+    adjustment_status: str = "unadjusted"
+
+    def __post_init__(self) -> None:
+        source = _required_text(self.source, "source").lower()
+        if self.max_attempts < 1:
+            raise ConfigurationError("max_attempts must be at least one")
+        if not math.isfinite(self.retry_backoff_seconds) or self.retry_backoff_seconds < 0:
+            raise ConfigurationError("retry_backoff_seconds must be finite and non-negative")
+        if not math.isfinite(self.timeout_seconds) or self.timeout_seconds <= 0:
+            raise ConfigurationError("timeout_seconds must be finite and greater than zero")
+        adjustment_status = _required_text(self.adjustment_status, "adjustment_status").lower()
+        if adjustment_status not in {"adjusted", "unadjusted", "unknown"}:
+            raise ConfigurationError("adjustment_status must be adjusted, unadjusted, or unknown")
+        object.__setattr__(self, "source", source)
+        object.__setattr__(self, "adjustment_status", adjustment_status)
+
+
+@dataclass(frozen=True, slots=True)
+class Settings:
+    """Complete immutable configuration for the data foundation."""
+
+    universe: UniverseConfig
+    storage: StorageConfig
+    validation: ValidationConfig
+    logging: LoggingConfig
+    ingestion: IngestionConfig
+    timezone: str = "Asia/Kolkata"
+
+
+def _validated_timezone(value: str) -> str:
+    timezone = _required_text(value, "timezone")
+    try:
+        ZoneInfo(timezone)
+    except ZoneInfoNotFoundError as exc:
+        raise ConfigurationError(f"unknown timezone: {timezone}") from exc
+    return timezone
+
+
+def _first_environment_value(
+    environment: Mapping[str, str], keys: tuple[str, ...], default: str
+) -> str:
+    for key in keys:
+        value = environment.get(key)
+        if value is not None and value.strip():
+            return value.strip()
+    return default
+
+
+def _parse_bool(environment: Mapping[str, str], keys: tuple[str, ...], default: bool) -> bool:
+    raw = _first_environment_value(environment, keys, str(default)).lower()
+    if raw in {"1", "true", "yes", "on"}:
+        return True
+    if raw in {"0", "false", "no", "off"}:
+        return False
+    raise ConfigurationError(f"{keys[0]} must be a boolean")
+
+
+def _parse_float(environment: Mapping[str, str], keys: tuple[str, ...], default: float) -> float:
+    raw = _first_environment_value(environment, keys, str(default))
+    try:
+        return float(raw)
+    except ValueError as exc:
+        raise ConfigurationError(f"{keys[0]} must be a number") from exc
+
+
+def _parse_int(environment: Mapping[str, str], keys: tuple[str, ...], default: int) -> int:
+    raw = _first_environment_value(environment, keys, str(default))
+    try:
+        return int(raw)
+    except ValueError as exc:
+        raise ConfigurationError(f"{keys[0]} must be an integer") from exc
+
+
+def _parse_csv(
+    environment: Mapping[str, str], keys: tuple[str, ...], default: tuple[str, ...]
+) -> tuple[str, ...]:
+    raw = _first_environment_value(environment, keys, ",".join(default))
+    values = tuple(item.strip() for item in raw.split(",") if item.strip())
+    if not values:
+        raise ConfigurationError(f"{keys[0]} must contain at least one value")
+    return values
+
+
+def _parse_holidays(environment: Mapping[str, str]) -> tuple[date, ...]:
+    raw = _first_environment_value(environment, ("QUANT_INDIA_HOLIDAYS",), "")
+    values: list[date] = []
+    for item in (value.strip() for value in raw.split(",")):
+        if not item:
+            continue
+        try:
+            values.append(date.fromisoformat(item))
+        except ValueError as exc:
+            raise ConfigurationError(f"invalid holiday date: {item}") from exc
+    return tuple(values)
+
+
+def _load_universe(
+    environment: Mapping[str, str],
+    universe_file: Path | str | None,
+    supported_exchanges: tuple[str, ...] | None,
+) -> UniverseConfig:
+    raw_json = environment.get("QUANT_INDIA_UNIVERSE_JSON")
+    if raw_json and raw_json.strip():
+        try:
+            payload = json.loads(raw_json)
+        except json.JSONDecodeError as exc:
+            raise ConfigurationError("QUANT_INDIA_UNIVERSE_JSON is not valid JSON") from exc
+        return UniverseConfig.from_mapping(payload, supported_exchanges=supported_exchanges)
+
+    configured_path = environment.get("QUANT_INDIA_UNIVERSE_FILE")
+    path = Path(configured_path).expanduser() if configured_path else universe_file
+    if path is None:
+        path = Path(__file__).with_name("universe.json")
+    return UniverseConfig.from_file(path, supported_exchanges=supported_exchanges)
+
+
+def load_settings(
+    environment: Mapping[str, str] | None = None,
+    universe_file: Path | str | None = None,
+) -> Settings:
+    """Load validated settings from environment variables and universe JSON.
+
+    Namespaced ``QUANT_INDIA_*`` variables take precedence. The existing
+    ``DATA_ROOT`` and ``LOG_LEVEL`` names remain accepted for local convenience.
+    """
+    values = os.environ if environment is None else environment
+    configured_exchanges = values.get("QUANT_INDIA_SUPPORTED_EXCHANGES")
+    supported_exchanges = (
+        _parse_csv(values, ("QUANT_INDIA_SUPPORTED_EXCHANGES",), SUPPORTED_EXCHANGES)
+        if configured_exchanges and configured_exchanges.strip()
+        else None
+    )
+    data_root = Path(
+        _first_environment_value(values, ("QUANT_INDIA_DATA_ROOT", "DATA_ROOT"), "data")
+    ).expanduser()
+    duckdb_raw = values.get("QUANT_INDIA_DUCKDB_PATH") or values.get("DUCKDB_PATH")
+    raw_root = values.get("QUANT_INDIA_RAW_ROOT")
+    clean_root = values.get("QUANT_INDIA_CLEAN_ROOT")
+    features_root = values.get("QUANT_INDIA_FEATURES_ROOT")
+    snapshots_root = values.get("QUANT_INDIA_SNAPSHOTS_ROOT")
+    storage = StorageConfig(
+        data_root=data_root,
+        raw_root=Path(raw_root).expanduser() if raw_root else None,
+        clean_root=Path(clean_root).expanduser() if clean_root else None,
+        features_root=Path(features_root).expanduser() if features_root else None,
+        snapshots_root=Path(snapshots_root).expanduser() if snapshots_root else None,
+        duckdb_path=Path(duckdb_raw).expanduser() if duckdb_raw else None,
+    )
+    validation = ValidationConfig(
+        stale_after_hours=_parse_float(
+            values, ("QUANT_INDIA_STALE_AFTER_HOURS",), ValidationConfig().stale_after_hours
+        ),
+        outlier_return_threshold=_parse_float(
+            values,
+            ("QUANT_INDIA_OUTLIER_RETURN_THRESHOLD",),
+            ValidationConfig().outlier_return_threshold,
+        ),
+        outlier_window=_parse_int(
+            values, ("QUANT_INDIA_OUTLIER_WINDOW",), ValidationConfig().outlier_window
+        ),
+        outlier_zscore=_parse_float(
+            values, ("QUANT_INDIA_OUTLIER_ZSCORE",), ValidationConfig().outlier_zscore
+        ),
+        holidays=_parse_holidays(values),
+    )
+    logging_config = LoggingConfig(
+        level=_first_environment_value(values, ("QUANT_INDIA_LOG_LEVEL", "LOG_LEVEL"), "INFO"),
+        json_output=_parse_bool(values, ("QUANT_INDIA_LOG_JSON",), True),
+        logger_name=_first_environment_value(values, ("QUANT_INDIA_LOGGER_NAME",), "quant_india"),
+    )
+    ingestion = IngestionConfig(
+        source=_first_environment_value(values, ("QUANT_INDIA_SOURCE",), "yfinance"),
+        max_attempts=_parse_int(
+            values, ("QUANT_INDIA_MAX_ATTEMPTS",), IngestionConfig().max_attempts
+        ),
+        retry_backoff_seconds=_parse_float(
+            values,
+            ("QUANT_INDIA_RETRY_BACKOFF_SECONDS",),
+            IngestionConfig().retry_backoff_seconds,
+        ),
+        timeout_seconds=_parse_float(
+            values, ("QUANT_INDIA_TIMEOUT_SECONDS",), IngestionConfig().timeout_seconds
+        ),
+        auto_adjust=_parse_bool(values, ("QUANT_INDIA_AUTO_ADJUST",), False),
+        adjustment_status=_first_environment_value(
+            values, ("QUANT_INDIA_ADJUSTMENT_STATUS",), "unadjusted"
+        ),
+    )
+    universe = _load_universe(values, universe_file, supported_exchanges)
+    timezone = _validated_timezone(
+        _first_environment_value(values, ("QUANT_INDIA_TIMEZONE", "TIMEZONE"), "Asia/Kolkata")
+    )
+    return Settings(
+        universe=universe,
+        storage=storage,
+        validation=validation,
+        logging=logging_config,
+        ingestion=ingestion,
+        timezone=timezone,
+    )
