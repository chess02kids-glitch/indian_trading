index 0000000..22c943b
--- /dev/null
+++ b/ingestion/database.py
@@ -0,0 +1,383 @@
+"""DuckDB analytical utilities for Parquet registration and snapshots."""
+
+from __future__ import annotations
+
+import json
+import logging
+import re
+from collections.abc import Iterator, Mapping, Sequence
+from contextlib import contextmanager
+from dataclasses import dataclass
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any
+
+import duckdb
+import pandas as pd
+
+from .errors import DatabaseError, SnapshotError
+
+_QUERY_PARAMETERS = Sequence[Any] | Mapping[str, Any]
+_IDENTIFIER_PATTERN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
+_SNAPSHOT_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
+
+
+@dataclass(frozen=True, slots=True)
+class DuckDBRegistration:
+    """Description of a Parquet relation registered as a DuckDB view."""
+
+    view_name: str
+    paths: tuple[Path, ...]
+    row_count: int
+
+
+@dataclass(frozen=True, slots=True)
+class DataSnapshot:
+    """Immutable manifest of Parquet partitions at a point in time."""
+
+    snapshot_id: str
+    created_at: datetime
+    description: str | None
+    partition_paths: tuple[Path, ...]
+
+
+def _quote_identifier(value: str) -> str:
+    if not isinstance(value, str) or not _IDENTIFIER_PATTERN.fullmatch(value):
+        raise DatabaseError(f"invalid DuckDB identifier: {value!r}")
+    return f'"{value}"'
+
+
+def _quote_sql_string(value: str) -> str:
+    return "'" + value.replace("'", "''") + "'"
+
+
+def _parquet_relation(paths: tuple[Path, ...]) -> str:
+    literals = ", ".join(_quote_sql_string(str(path)) for path in paths)
+    return f"read_parquet([{literals}], union_by_name = true)"
+
+
+def _snapshot_view_name(snapshot_id: str) -> str:
+    return "snapshot_" + re.sub(r"[^A-Za-z0-9_]", "_", snapshot_id)
+
+
+def _as_utc(value: datetime) -> datetime:
+    if value.tzinfo is None:
+        return value.replace(tzinfo=UTC)
+    return value.astimezone(UTC)
+
+
+class DuckDBManager:
+    """Manage a DuckDB file while keeping Parquet as the source of truth."""
+
+    def __init__(
+        self,
+        database_path: Path | str,
+        read_only: bool = False,
+        logger: logging.Logger | None = None,
+    ) -> None:
+        self.database_path: Path | str = (
+            database_path if database_path == ":memory:" else Path(database_path).expanduser()
+        )
+        self.read_only = read_only
+        self.logger = logger or logging.getLogger(__name__)
+        self._memory_connection: duckdb.DuckDBPyConnection | None = None
+
+    def connect(self) -> duckdb.DuckDBPyConnection:
+        """Open a connection, reusing the manager-owned in-memory connection."""
+        if self.database_path == ":memory:":
+            if self._memory_connection is None:
+                try:
+                    self._memory_connection = duckdb.connect(":memory:")
+                except duckdb.Error as exc:
+                    raise DatabaseError("failed to open in-memory DuckDB") from exc
+            return self._memory_connection
+
+        path = Path(self.database_path)
+        if not self.read_only:
+            path.parent.mkdir(parents=True, exist_ok=True)
+        try:
+            return duckdb.connect(database=str(path), read_only=self.read_only)
+        except duckdb.Error as exc:
+            raise DatabaseError(f"failed to open DuckDB database: {path}") from exc
+
+    @contextmanager
+    def connection(self) -> Iterator[duckdb.DuckDBPyConnection]:
+        """Yield a connection and close file-backed connections on exit."""
+        connection = self.connect()
+        try:
+            yield connection
+        finally:
+            if self.database_path != ":memory:":
+                connection.close()
+
+    def close(self) -> None:
+        """Close the manager-owned in-memory connection, if one exists."""
+        if self._memory_connection is not None:
+            self._memory_connection.close()
+            self._memory_connection = None
+
+    @staticmethod
+    def _ensure_schema(connection: duckdb.DuckDBPyConnection) -> None:
+        connection.execute(
+            """
+            CREATE TABLE IF NOT EXISTS data_catalog (
+                partition_path VARCHAR PRIMARY KEY,
+                source VARCHAR NOT NULL,
+                exchange VARCHAR NOT NULL,
+                symbol VARCHAR NOT NULL,
+                row_count BIGINT NOT NULL,
+                min_date DATE,
+                max_date DATE,
+                registered_at TIMESTAMPTZ NOT NULL
+            )
+            """
+        )
+        connection.execute(
+            """
+            CREATE TABLE IF NOT EXISTS data_snapshots (
+                snapshot_id VARCHAR PRIMARY KEY,
+                created_at TIMESTAMPTZ NOT NULL,
+                description VARCHAR,
+                partition_count BIGINT NOT NULL,
+                manifest_json VARCHAR NOT NULL
+            )
+            """
+        )
+
+    def initialize(self) -> None:
+        """Create the catalog and snapshot schemas if they do not exist.
+
+        A read-only manager verifies that the schemas are present without
+        attempting a write.
+        """
+        with self.connection() as connection:
+            try:
+                if self.read_only:
+                    connection.execute("SELECT 1 FROM data_catalog LIMIT 0")
+                    connection.execute("SELECT 1 FROM data_snapshots LIMIT 0")
+                else:
+                    self._ensure_schema(connection)
+            except duckdb.Error as exc:
+                raise DatabaseError("failed to initialize DuckDB schema") from exc
+
+    @staticmethod
+    def _normalise_paths(paths: Sequence[Path | str]) -> tuple[Path, ...]:
+        result = tuple(Path(path).expanduser().resolve() for path in paths)
+        if not result:
+            raise DatabaseError("at least one Parquet path is required")
+        if len(set(result)) != len(result):
+            raise DatabaseError("Parquet paths must be unique")
+        for path in result:
+            if not path.is_file() or path.suffix != ".parquet":
+                raise DatabaseError(f"Parquet path does not exist: {path}")
+        return tuple(sorted(result))
+
+    def register_parquet(
+        self,
+        path: Path | str,
+        view_name: str = "market_data",
+    ) -> DuckDBRegistration:
+        """Register one Parquet file as a DuckDB view and catalog entry."""
+        return self.register_parquet_files((path,), view_name=view_name)
+
+    def register_parquet_files(
+        self,
+        paths: Sequence[Path | str],
+        view_name: str = "market_data",
+    ) -> DuckDBRegistration:
+        """Register Parquet files without copying them into DuckDB tables."""
+        _quote_identifier(view_name)
+        normalised_paths = self._normalise_paths(paths)
+        self.initialize()
+        relation = _parquet_relation(normalised_paths)
+        registered_at = datetime.now(UTC)
+        try:
+            with self.connection() as connection:
+                connection.execute(
+                    f"CREATE OR REPLACE VIEW {_quote_identifier(view_name)} AS "
+                    f"SELECT * FROM {relation}"
+                )
+                total_row = connection.execute(
+                    f"""
+                    SELECT
+                        COUNT(*)::BIGINT,
+                        MIN(CAST(date AS DATE)),
+                        MAX(CAST(date AS DATE)),
+                        MIN(source),
+                        MIN(exchange),
+                        MIN(symbol)
+                    FROM {relation}
+                    """
+                ).fetchone()
+                total_count = int(total_row[0] or 0)
+                for path in normalised_paths:
+                    path_relation = _parquet_relation((path,))
+                    row = connection.execute(
+                        f"""
+                        SELECT
+                            COUNT(*)::BIGINT,
+                            MIN(CAST(date AS DATE)),
+                            MAX(CAST(date AS DATE)),
+                            MIN(source),
+                            MIN(exchange),
+                            MIN(symbol)
+                        FROM {path_relation}
+                        """
+                    ).fetchone()
+                    if row[3] is None or row[4] is None or row[5] is None:
+                        raise DatabaseError(f"Parquet partition has no metadata: {path}")
+                    connection.execute(
+                        """
+                        INSERT INTO data_catalog (
+                            partition_path, source, exchange, symbol, row_count,
+                            min_date, max_date, registered_at
+                        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
+                        ON CONFLICT (partition_path) DO UPDATE SET
+                            source = excluded.source,
+                            exchange = excluded.exchange,
+                            symbol = excluded.symbol,
+                            row_count = excluded.row_count,
+                            min_date = excluded.min_date,
+                            max_date = excluded.max_date,
+                            registered_at = excluded.registered_at
+                        """,
+                        [
+                            str(path),
+                            row[3],
+                            row[4],
+                            row[5],
+                            int(row[0] or 0),
+                            row[1],
+                            row[2],
+                            registered_at,
+                        ],
+                    )
+        except DatabaseError:
+            raise
+        except duckdb.Error as exc:
+            raise DatabaseError(f"failed to register Parquet files as {view_name!r}") from exc
+        self.logger.info(
+            "parquet_registered",
+            extra={
+                "operation": "register_parquet_files",
+                "view_name": view_name,
+                "partition_count": len(normalised_paths),
+                "rows": total_count,
+            },
+        )
+        return DuckDBRegistration(view_name, normalised_paths, total_count)
+
+    def query(
+        self,
+        sql: str,
+        parameters: _QUERY_PARAMETERS | None = None,
+    ) -> pd.DataFrame:
+        """Execute a read query and return its result as a pandas DataFrame."""
+        if not isinstance(sql, str) or not sql.strip():
+            raise DatabaseError("sql must be a non-empty string")
+        try:
+            with self.connection() as connection:
+                return connection.execute(sql, parameters).fetchdf()
+        except duckdb.Error as exc:
+            raise DatabaseError("DuckDB query failed") from exc
+
+    def query_scalar(
+        self,
+        sql: str,
+        parameters: _QUERY_PARAMETERS | None = None,
+    ) -> object:
+        """Execute a query and return its first cell, or ``None`` if empty."""
+        result = self.query(sql, parameters)
+        if result.empty:
+            return None
+        return result.iloc[0, 0]
+
+    @staticmethod
+    def _snapshot_from_row(row: tuple[Any, ...]) -> DataSnapshot:
+        try:
+            paths = tuple(Path(path) for path in json.loads(row[4]))
+        except (TypeError, json.JSONDecodeError) as exc:
+            raise SnapshotError("stored snapshot manifest is invalid") from exc
+        return DataSnapshot(
+            snapshot_id=str(row[0]),
+            created_at=_as_utc(row[1]),
+            description=str(row[2]) if row[2] is not None else None,
+            partition_paths=paths,
+        )
+
+    def create_snapshot(
+        self,
+        snapshot_id: str,
+        paths: Sequence[Path | str],
+        description: str | None = None,
+    ) -> DataSnapshot:
+        """Persist an immutable Parquet manifest and expose its snapshot view."""
+        if not isinstance(snapshot_id, str) or not _SNAPSHOT_PATTERN.fullmatch(snapshot_id):
+            raise SnapshotError("snapshot_id contains unsupported characters")
+        if description is not None and not isinstance(description, str):
+            raise SnapshotError("snapshot description must be a string or None")
+        normalised_paths = self._normalise_paths(paths)
+        manifest = json.dumps([str(path) for path in normalised_paths], separators=(",", ":"))
+        self.register_parquet_files(normalised_paths, view_name=_snapshot_view_name(snapshot_id))
+        self.initialize()
+        try:
+            with self.connection() as connection:
+                existing = connection.execute(
+                    """
+                    SELECT snapshot_id, created_at, description, partition_count, manifest_json
+                    FROM data_snapshots WHERE snapshot_id = ?
+                    """,
+                    [snapshot_id],
+                ).fetchone()
+                if existing is not None:
+                    if existing[4] != manifest:
+                        raise SnapshotError(
+                            f"snapshot already exists with a different manifest: {snapshot_id}"
+                        )
+                    return self._snapshot_from_row(existing)
+                created_at = datetime.now(UTC)
+                connection.execute(
+                    """
+                    INSERT INTO data_snapshots (
+                        snapshot_id, created_at, description, partition_count, manifest_json
+                    ) VALUES (?, ?, ?, ?, ?)
+                    """,
+                    [snapshot_id, created_at, description, len(normalised_paths), manifest],
+                )
+                return DataSnapshot(snapshot_id, created_at, description, normalised_paths)
+        except SnapshotError:
+            raise
+        except duckdb.Error as exc:
+            raise SnapshotError(f"failed to create snapshot: {snapshot_id}") from exc
+
+    def get_snapshot(self, snapshot_id: str) -> DataSnapshot:
+        """Load one snapshot manifest from the DuckDB catalog."""
+        if not isinstance(snapshot_id, str) or not _SNAPSHOT_PATTERN.fullmatch(snapshot_id):
+            raise SnapshotError("snapshot_id contains unsupported characters")
+        self.initialize()
+        try:
+            with self.connection() as connection:
+                row = connection.execute(
+                    """
+                    SELECT snapshot_id, created_at, description, partition_count, manifest_json
+                    FROM data_snapshots WHERE snapshot_id = ?
+                    """,
+                    [snapshot_id],
+                ).fetchone()
+        except duckdb.Error as exc:
+            raise SnapshotError(f"failed to load snapshot: {snapshot_id}") from exc
+        if row is None:
+            raise SnapshotError(f"snapshot does not exist: {snapshot_id}")
+        return self._snapshot_from_row(row)
+
+    def register_snapshot(
+        self,
+        snapshot_id: str,
+        view_name: str | None = None,
+    ) -> DuckDBRegistration:
+        """Register the immutable partitions in an existing snapshot view."""
+        snapshot = self.get_snapshot(snapshot_id)
+        return self.register_parquet_files(
+            snapshot.partition_paths,
+            view_name=view_name or _snapshot_view_name(snapshot_id),
+        )
