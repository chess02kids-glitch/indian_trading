+"""Exception types used by the Quant India market-data foundation."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from .validation import ValidationReport
+
+
+class DataFoundationError(Exception):
+    """Base class for expected data-foundation failures."""
+
+
+class ProviderError(DataFoundationError):
+    """Raised when a market-data provider cannot return usable data."""
+
+
+class NormalizationError(DataFoundationError):
+    """Raised when provider data cannot be mapped to the canonical schema."""
+
+
+class StorageError(DataFoundationError):
+    """Raised for Parquet filesystem and partitioning failures."""
+
+
+class ImmutablePartitionError(StorageError):
+    """Raised when a partition already contains different immutable data."""
+
+
+class DatabaseError(DataFoundationError):
+    """Raised for DuckDB catalog and analytical-layer failures."""
+
+
+class SnapshotError(DatabaseError):
+    """Raised when a snapshot cannot be created or resolved."""
+
+
+class ValidationError(DataFoundationError):
+    """Raised when validation reports one or more blocking errors."""
+
+    def __init__(self, report: ValidationReport) -> None:
+        self.report = report
+        super().__init__(report.to_json())
+
+
+class IngestionBatchError(DataFoundationError):
+    """Raised when one or more symbols fail in a non-fail-fast batch."""
+
+    def __init__(self, failures: dict[str, Exception]) -> None:
+        self.failures = failures
+        names = ", ".join(sorted(failures))
+        super().__init__(f"ingestion failed for {len(failures)} symbol(s): {names}")
