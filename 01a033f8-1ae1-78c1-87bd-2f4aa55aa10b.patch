+"""Tests for immutable Parquet storage and DuckDB catalog utilities."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from ingestion.database import DuckDBManager
+from ingestion.errors import DatabaseError, ImmutablePartitionError, SnapshotError, StorageError
+from ingestion.normalization import normalize_market_data
+from ingestion.storage import ParquetStorage
+
+
+def _normalized(raw_frame: pd.DataFrame, symbol: str = "ABC") -> pd.DataFrame:
+    """Normalize a fixture frame with a deterministic ingestion timestamp."""
+    return normalize_market_data(
+        raw_frame,
+        symbol=symbol,
+        exchange="NSE",
+        ingestion_timestamp=datetime(2024, 1, 4, tzinfo=UTC),
+    )
+
+
+def test_parquet_storage_creates_monthly_partitions(tmp_path: Path) -> None:
+    """Rows spanning months are written to the required partition layout."""
+    raw = pd.DataFrame(
+        {
+            "Open": [10.0, 11.0, 12.0],
+            "High": [12.0, 13.0, 14.0],
+            "Low": [9.0, 10.0, 11.0],
+            "Close": [11.0, 12.0, 13.0],
+            "Volume": [100.0, 110.0, 120.0],
+        },
+        index=pd.to_datetime(["2024-01-30", "2024-01-31", "2024-02-01"]),
+    )
+    storage = ParquetStorage(tmp_path / "raw")
+    result = storage.write_immutable(_normalized(raw))
+    expected = {
+        tmp_path / "raw" / "yfinance" / "NSE" / "ABC" / "2024" / "01.parquet",
+        tmp_path / "raw" / "yfinance" / "NSE" / "ABC" / "2024" / "02.parquet",
+    }
+    assert set(result.written) == expected
+    assert set(storage.list_partitions()) == expected
+    assert storage.read_partition(next(iter(expected))).shape[0] in {1, 2}
+
+
+def test_parquet_storage_is_idempotent_but_never_overwrites(tmp_path: Path, raw_frame) -> None:
+    """Identical retries skip explicitly while changed content is rejected."""
+    storage = ParquetStorage(tmp_path / "raw")
+    frame = _normalized(raw_frame)
+    first = storage.write_immutable(frame)
+    second = storage.write_immutable(
+        frame.assign(ingestion_timestamp=pd.Timestamp("2025-01-01", tz="UTC"))
+    )
+    assert len(first.written) == 1
+    assert len(second.skipped) == 1
+
+    changed = frame.copy()
+    changed.loc[0, "close"] = 999.0
+    with pytest.raises(ImmutablePartitionError, match="overwrite"):
+        storage.write_immutable(changed)
+
+
+def test_parquet_storage_rejects_unsafe_paths(tmp_path: Path) -> None:
+    """Partition paths cannot escape the configured storage root."""
+    storage = ParquetStorage(tmp_path / "raw")
+    with pytest.raises(StorageError, match="safe partition"):
+        storage.partition_path("yfinance", "NSE", "../ABC", 2024, 1)
+    with pytest.raises(StorageError, match="outside"):
+        storage.read_partition(tmp_path / "outside.parquet")
+
+
+def test_duckdb_registers_parquet_and_supports_queries(tmp_path: Path, raw_frame) -> None:
+    """DuckDB registers files as views and records catalog metadata."""
+    storage = ParquetStorage(tmp_path / "raw")
+    storage.write_immutable(_normalized(raw_frame))
+    paths = storage.list_partitions()
+    manager = DuckDBManager(tmp_path / "catalog.duckdb")
+    manager.initialize()
+    registration = manager.register_parquet_files(paths)
+    assert registration.row_count == 2
+    assert manager.query_scalar("SELECT COUNT(*) FROM market_data") == 2
+    assert manager.register_parquet(paths[0], "single_data").row_count == 2
+    catalog = manager.query("SELECT source, exchange, symbol, row_count FROM data_catalog")
+    assert catalog.to_dict("records") == [
+        {"source": "yfinance", "exchange": "NSE", "symbol": "ABC", "row_count": 2}
+    ]
+    manager.close()
+
+
+def test_duckdb_snapshot_is_immutable_and_re_registerable(tmp_path: Path, raw_frame) -> None:
+    """Snapshots persist manifests and can recreate analytical views."""
+    storage = ParquetStorage(tmp_path / "raw")
+    storage.write_immutable(_normalized(raw_frame))
+    paths = storage.list_partitions()
+    manager = DuckDBManager(tmp_path / "catalog.duckdb")
+    snapshot = manager.create_snapshot("2024-01", paths, description="January")
+    loaded = manager.get_snapshot("2024-01")
+    assert loaded == snapshot
+    assert manager.query_scalar('SELECT COUNT(*) FROM "snapshot_2024_01"') == 2
+    assert manager.register_snapshot("2024-01", "january_data").row_count == 2
+
+    extra = _normalized(raw_frame)
+    extra["date"] = pd.to_datetime(["2024-02-01", "2024-02-02"])
+    storage.write_immutable(extra)
+    with pytest.raises(SnapshotError, match="different manifest"):
+        manager.create_snapshot("2024-01", storage.list_partitions())
+    manager.close()
+    reader = DuckDBManager(tmp_path / "catalog.duckdb", read_only=True)
+    assert reader.get_snapshot("2024-01").snapshot_id == "2024-01"
+    reader.close()
+
+
+def test_duckdb_connection_context_closes_file_connection(tmp_path: Path) -> None:
+    """The connection context provides explicit lifecycle management."""
+    manager = DuckDBManager(tmp_path / "catalog.duckdb")
+    with manager.connection() as connection:
+        connection.execute("SELECT 1")
+    with pytest.raises(DatabaseError):
+        manager.query("SELECT * FROM missing_table")
