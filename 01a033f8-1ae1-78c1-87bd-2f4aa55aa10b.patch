+    "INFY",
+    "ITC",
+    "JIOFIN",
+    "JSWSTEEL",
+    "KOTAKBANK",
+    "LT",
+    "M&M",
+    "MARUTI",
+    "NESTLEIND",
+    "NTPC",
+    "ONGC",
+    "POWERGRID",
+    "RELIANCE",
+    "SBILIFE",
+    "SBIN",
+    "SHRIRAMFIN",
+    "SUNPHARMA",
+    "TATACONSUM",
+    "TATAMOTORS",
+    "TATASTEEL",
+    "TCS",
+    "TECHM",
+    "TITAN",
+    "TRENT",
+    "ULTRACEMCO",
+    "WIPRO",
+)
+_NIFTY_100_ADDITIONS = (
+    "ABB",
+    "ADANIENSOL",
+    "ADANIGREEN",
+    "AMBUJACEM",
+    "BANKBARODA",
+    "BDL",
+    "BHEL",
+    "BOSCHLTD",
+    "BPCL",
+    "CANBK",
+    "CHOLAFIN",
+    "COLPAL",
+    "DABUR",
+    "DIVISLAB",
+    "DLF",
+    "DMART",
+    "GAIL",
+    "GLAND",
+    "GODREJCP",
+    "GODREJPROP",
+    "HAL",
+    "HAVELLS",
+    "ICICIGI",
+    "ICICIPRULI",
+    "IDFCFIRSTB",
+    "INDHOTEL",
+    "IOC",
+    "IRCTC",
+    "JINDALSTEL",
+    "LODHA",
+    "LUPIN",
+    "MARICO",
+    "MAXHEALTH",
+    "MOTHERSON",
+    "NHPC",
+    "PERSISTENT",
+    "PIDILITIND",
