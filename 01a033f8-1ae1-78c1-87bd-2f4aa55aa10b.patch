+++ b/ingestion/pipeline.py
@@ -0,0 +1,183 @@
+"""Reusable orchestration of provider download, validation, storage, and cataloging."""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+from config.settings import UniverseConfig, UniverseEntry
+
+from .database import DuckDBManager, DuckDBRegistration
+from .errors import IngestionBatchError
+from .normalization import normalize_market_data
+from .provider import DateLike, MarketDataProvider
+from .storage import ParquetStorage
+from .validation import MarketDataValidator, ValidationReport, expected_trading_days
+
+Clock = Callable[[], datetime]
+
+
+def _date_part(value: DateLike, field_name: str) -> date:
+    if isinstance(value, datetime):
+        return value.date()
+    if isinstance(value, date):
+        return value
+    raise TypeError(f"{field_name} must be a date or datetime")
+
+
+@dataclass(frozen=True, slots=True)
+class IngestionResult:
+    """Auditable outcome for one symbol ingestion."""
+
+    symbol: str
+    exchange: str
+    source: str
+    row_count: int
+    written_partitions: tuple[Path, ...]
+    skipped_partitions: tuple[Path, ...]
+    registration: DuckDBRegistration
+    validation: ValidationReport
+
+
+@dataclass(slots=True)
+class MarketDataIngestor:
+    """Coordinate one provider through normalization, controls, and persistence."""
+
+    provider: MarketDataProvider
+    storage: ParquetStorage
+    database: DuckDBManager
+    validator: MarketDataValidator
+    source: str | None = None
+    adjustment_status: str = "unadjusted"
+    view_name: str = "market_data"
+    logger: logging.Logger | None = field(default=None, repr=False)
+    clock: Clock = field(default=lambda: datetime.now(UTC), repr=False)
+
+    def __post_init__(self) -> None:
+        provider_source = getattr(self.provider, "source", "yfinance")
+        self.source = (self.source or provider_source).strip().lower()
+        if not self.source:
+            raise ValueError("source must be a non-empty string")
+        if self.adjustment_status not in {"adjusted", "unadjusted", "unknown"}:
+            raise ValueError("adjustment_status must be adjusted, unadjusted, or unknown")
+        if not self.view_name.strip():
+            raise ValueError("view_name must be a non-empty string")
+
+    def ingest_symbol(
+        self,
+        entry: UniverseEntry,
+        start: DateLike,
+        end: DateLike,
+        check_stale: bool | None = None,
+    ) -> IngestionResult:
+        """Download, validate, persist, and register one configured symbol.
+
+        Freshness is checked by default for current-session requests and
+        skipped for historical backfills. Pass ``check_stale`` explicitly to
+        override that automatic distinction.
+        """
+        logger = self.logger or logging.getLogger(__name__)
+        context = {
+            "operation": "ingest_symbol",
+            "symbol": entry.symbol,
+            "exchange": entry.exchange,
+            "source": self.source,
+        }
+        logger.info("ingestion_started", extra=context)
+        raw = self.provider.download_history(entry.ticker, start, end)
+        ingested_at = self.clock()
+        if check_stale is None:
+            check_stale = _date_part(end, "end") >= ingested_at.date()
+        normalized = normalize_market_data(
+            raw,
+            symbol=entry.symbol,
+            exchange=entry.exchange,
+            source=self.source,
+            adjustment_status=self.adjustment_status,
+            ingestion_timestamp=ingested_at,
+        )
+        expected_dates = expected_trading_days(
+            start,
+            end,
+            holidays=self.validator.config.holidays,
+        )
+        validation = self.validator.validate_or_raise(
+            normalized,
+            expected_dates=expected_dates,
+            now=ingested_at,
+            check_stale=check_stale,
+        )
+        write_result = self.storage.write_immutable(normalized)
+        # Keep the default analytical view global so ingesting a second symbol
+        # does not hide the partitions already registered for the first one.
+        partitions = tuple(self.storage.list_partitions())
+        registration = self.database.register_parquet_files(partitions, view_name=self.view_name)
+        result = IngestionResult(
+            symbol=entry.symbol,
+            exchange=entry.exchange,
+            source=self.source,
+            row_count=len(normalized),
+            written_partitions=write_result.written,
+            skipped_partitions=write_result.skipped,
+            registration=registration,
+            validation=validation,
+        )
+        logger.info(
+            "ingestion_completed",
+            extra={
+                **context,
+                "rows": result.row_count,
+                "partitions_written": len(result.written_partitions),
+                "partitions_skipped": len(result.skipped_partitions),
+            },
+        )
+        return result
+
+    def ingest_universe(
+        self,
+        universe: UniverseConfig,
+        start: DateLike,
+        end: DateLike,
+        fail_fast: bool = False,
+        check_stale: bool | None = None,
+    ) -> tuple[IngestionResult, ...]:
+        """Ingest every configured symbol and report batch failures explicitly.
+
+        ``fail_fast=False`` collects all symbol failures before raising
+        :class:`IngestionBatchError`; ``check_stale`` is forwarded to each
+        symbol operation.
+        """
+        results: list[IngestionResult] = []
+        failures: dict[str, Exception] = {}
+        for entry in universe.symbols:
+            key = f"{entry.exchange}:{entry.symbol}"
+            try:
+                results.append(
+                    self.ingest_symbol(
+                        entry,
+                        start,
+                        end,
+                        check_stale=check_stale,
+                    )
+                )
+            except Exception as exc:
+                failures[key] = exc
+                (self.logger or logging.getLogger(__name__)).error(
+                    "ingestion_failed",
+                    extra={
+                        "operation": "ingest_universe",
+                        "symbol": entry.symbol,
+                        "exchange": entry.exchange,
+                        "source": self.source,
+                        "error": str(exc),
+                    },
+                    exc_info=True,
+                )
+                if fail_fast:
+                    raise
+        if failures:
+            raise IngestionBatchError(failures)
+        return tuple(results)
