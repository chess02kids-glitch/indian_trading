+"""Shared test data factories for the data-foundation test suite."""
+
+from __future__ import annotations
+
+import pandas as pd
+import pytest
+
+
+def _raw_frame(dates: tuple[str, ...] = ("2024-01-02", "2024-01-03")) -> pd.DataFrame:
+    """Return a deterministic yfinance-shaped response for unit tests."""
+    count = len(dates)
+    values = [float(10 + index) for index in range(count)]
+    return pd.DataFrame(
+        {
+            "Open": values,
+            "High": [value + 2 for value in values],
+            "Low": [value - 1 for value in values],
+            "Close": [value + 1 for value in values],
+            "Adj Close": [value + 1 for value in values],
+            "Volume": [100.0 + index * 10 for index in range(count)],
+        },
+        index=pd.to_datetime(dates),
+    )
+
+
+@pytest.fixture
+def raw_frame() -> pd.DataFrame:
+    """Provide a deterministic two-day provider response."""
+    return _raw_frame()
