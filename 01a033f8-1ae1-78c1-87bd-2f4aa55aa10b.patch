+"""Construct the configured data-foundation components."""
+
+from __future__ import annotations
+
+import logging
+
+from config.settings import Settings
+
+from .database import DuckDBManager
+from .pipeline import MarketDataIngestor
+from .provider import YFinanceProvider
+from .storage import ParquetStorage
+from .structured_logging import configure_logging
+from .validation import MarketDataValidator
+
+
+def build_ingestor(
+    settings: Settings,
+    logger: logging.Logger | None = None,
+) -> MarketDataIngestor:
+    """Build a yfinance-backed ingestor from validated application settings."""
+    if not isinstance(settings, Settings):
+        raise TypeError("settings must be a Settings instance")
+    if settings.ingestion.source != "yfinance":
+        raise ValueError("build_ingestor currently supports the yfinance provider only")
+    configured_logger = logger or configure_logging(settings.logging)
+    provider = YFinanceProvider(
+        max_attempts=settings.ingestion.max_attempts,
+        retry_backoff_seconds=settings.ingestion.retry_backoff_seconds,
+        timeout_seconds=settings.ingestion.timeout_seconds,
+        auto_adjust=settings.ingestion.auto_adjust,
+        logger=configured_logger,
+    )
+    return MarketDataIngestor(
+        provider=provider,
+        storage=ParquetStorage(settings.storage.raw_root, logger=configured_logger),
+        database=DuckDBManager(settings.storage.duckdb_path, logger=configured_logger),
+        validator=MarketDataValidator(settings.validation, logger=configured_logger),
+        source=settings.ingestion.source,
+        adjustment_status=settings.ingestion.adjustment_status,
+        logger=configured_logger,
+    )
