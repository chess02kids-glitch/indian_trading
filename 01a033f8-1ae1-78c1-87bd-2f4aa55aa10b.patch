@@ -0,0 +1,170 @@
+"""Normalization of provider responses into the canonical candle schema."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from typing import Final
+
+import pandas as pd
+
+from .errors import NormalizationError
+
+CANONICAL_COLUMNS: Final[tuple[str, ...]] = (
+    "date",
+    "symbol",
+    "exchange",
+    "open",
+    "high",
+    "low",
+    "close",
+    "adj_close",
+    "volume",
+    "source",
+    "source_timestamp",
+    "ingestion_timestamp",
+    "adjustment_status",
+)
+"""Stable column order written to every raw Parquet partition."""
+
+_REQUIRED_PRICE_COLUMNS: Final[tuple[str, ...]] = (
+    "open",
+    "high",
+    "low",
+    "close",
+    "volume",
+)
+_COLUMN_ALIASES: Final[dict[str, str]] = {
+    "open": "open",
+    "high": "high",
+    "low": "low",
+    "close": "close",
+    "adj close": "adj_close",
+    "adjclose": "adj_close",
+    "adjusted close": "adj_close",
+    "volume": "volume",
+}
+_DATE_NAMES: Final[frozenset[str]] = frozenset({"date", "datetime", "timestamp", "time"})
+
+
+def _label_parts(column: object) -> tuple[str, ...]:
+    if isinstance(column, tuple):
+        return tuple(str(part).strip() for part in column)
+    return (str(column).strip(),)
+
+
+def _normalise_label(value: str) -> str:
+    return " ".join(value.lower().replace("_", " ").replace("-", " ").split())
+
+
+def _find_columns(frame: pd.DataFrame) -> dict[str, int]:
+    matches: dict[str, int] = {}
+    for position, column in enumerate(frame.columns):
+        for part in _label_parts(column):
+            target = _COLUMN_ALIASES.get(_normalise_label(part))
+            if target is None:
+                continue
+            if target in matches:
+                raise NormalizationError(f"provider response contains duplicate {target} columns")
+            matches[target] = position
+            break
+    missing = [column for column in _REQUIRED_PRICE_COLUMNS if column not in matches]
+    if missing:
+        raise NormalizationError(
+            "provider response is missing required columns: " + ", ".join(missing)
+        )
+    return matches
+
+
+def _find_date_column(frame: pd.DataFrame) -> int | None:
+    for position, column in enumerate(frame.columns):
+        if any(_normalise_label(part) in _DATE_NAMES for part in _label_parts(column)):
+            return position
+    return None
+
+
+def _timestamp_series(frame: pd.DataFrame, date_column: int | None) -> pd.Series:
+    if date_column is None:
+        if isinstance(frame.index, pd.RangeIndex):
+            raise NormalizationError(
+                "provider response must contain a date column or datetime index"
+            )
+        source_values = frame.index
+    else:
+        source_values = frame.iloc[:, date_column]
+    timestamps = pd.to_datetime(source_values, errors="coerce", utc=True)
+    result = pd.Series(timestamps.to_numpy(), index=frame.index)
+    if result.isna().any():
+        invalid_count = int(result.isna().sum())
+        raise NormalizationError(f"provider response contains {invalid_count} invalid timestamps")
+    return result
+
+
+def _utc_timestamp(value: datetime) -> pd.Timestamp:
+    timestamp = pd.Timestamp(value)
+    if timestamp.tzinfo is None:
+        return timestamp.tz_localize("UTC")
+    return timestamp.tz_convert("UTC")
+
+
+def normalize_market_data(
+    frame: pd.DataFrame,
+    symbol: str,
+    exchange: str,
+    source: str = "yfinance",
+    adjustment_status: str = "unadjusted",
+    ingestion_timestamp: datetime | None = None,
+) -> pd.DataFrame:
+    """Normalize one provider response to the immutable candle schema.
+
+    The input is never modified. Provider column aliases and yfinance
+    multi-index columns are handled, timestamps are retained in UTC, and a
+    normalized calendar ``date`` is added for partitioning and validation.
+    Numeric nulls are intentionally retained for the validation stage instead
+    of being silently dropped.
+
+    Args:
+        frame: Provider OHLCV response with a date index or date column.
+        symbol: Canonical instrument symbol.
+        exchange: Canonical exchange code.
+        source: Provider identifier stored with every row.
+        adjustment_status: ``adjusted``, ``unadjusted``, or ``unknown``.
+        ingestion_timestamp: Optional UTC timestamp for deterministic tests.
+
+    Returns:
+        A new, sorted DataFrame with :data:`CANONICAL_COLUMNS`.
+
+    Raises:
+        NormalizationError: If required columns, timestamps, or metadata are invalid.
+    """
+    if not isinstance(frame, pd.DataFrame) or frame.empty:
+        raise NormalizationError("provider response must be a non-empty pandas DataFrame")
+    for value, name in ((symbol, "symbol"), (exchange, "exchange"), (source, "source")):
+        if not isinstance(value, str) or not value.strip():
+            raise NormalizationError(f"{name} must be a non-empty string")
+    if adjustment_status not in {"adjusted", "unadjusted", "unknown"}:
+        raise NormalizationError("adjustment_status must be adjusted, unadjusted, or unknown")
+
+    columns = _find_columns(frame)
+    timestamps = _timestamp_series(frame, _find_date_column(frame))
+    output = pd.DataFrame(index=frame.index)
+    output["date"] = timestamps.dt.tz_localize(None).dt.normalize().to_numpy()
+    output["symbol"] = symbol.strip().upper()
+    output["exchange"] = exchange.strip().upper()
+
+    for target in _REQUIRED_PRICE_COLUMNS + ("adj_close",):
+        if target not in columns:
+            output[target] = float("nan")
+            continue
+        values = pd.to_numeric(frame.iloc[:, columns[target]], errors="coerce")
+        output[target] = values.to_numpy(dtype="float64", na_value=float("nan"))
+
+    output["source"] = source.strip().lower()
+    output["source_timestamp"] = timestamps.to_numpy()
+    stamp = _utc_timestamp(ingestion_timestamp or datetime.now(UTC))
+    output["ingestion_timestamp"] = pd.Series(
+        [stamp] * len(output), index=output.index, dtype="datetime64[ns, UTC]"
+    )
+    output["adjustment_status"] = adjustment_status
+    return output.sort_values(["date", "source_timestamp"], kind="stable").reset_index(drop=True)[
+        list(CANONICAL_COLUMNS)
+    ]
