+"""Tests for completeness, integrity, freshness, and outlier validation."""
+
+from __future__ import annotations
+
+from datetime import UTC, date, datetime, timedelta
+
+import pandas as pd
+import pytest
+
+from config.settings import ValidationConfig
+from ingestion.errors import ValidationError
+from ingestion.normalization import normalize_market_data
+from ingestion.validation import (
+    MarketDataValidator,
+    ValidationIssue,
+    ValidationReport,
+    check_duplicate_rows,
+    check_missing_candles,
+    check_ohlc,
+    check_outliers,
+    check_stale_data,
+    expected_trading_days,
+)
+
+
+def _frame(dates: tuple[str, ...] = ("2024-01-02", "2024-01-03")) -> pd.DataFrame:
+    """Build canonical data with stable timestamps for validation tests."""
+    count = len(dates)
+    raw = pd.DataFrame(
+        {
+            "Open": [10.0 + index for index in range(count)],
+            "High": [12.0 + index for index in range(count)],
+            "Low": [9.0 + index for index in range(count)],
+            "Close": [11.0 + index for index in range(count)],
+            "Volume": [100.0 + index for index in range(count)],
+        },
+        index=pd.to_datetime(dates),
+    )
+    return normalize_market_data(
+        raw,
+        symbol="ABC",
+        exchange="NSE",
+        ingestion_timestamp=datetime(2024, 1, 4, tzinfo=UTC),
+    )
+
+
+def test_expected_trading_days_excludes_weekends_and_holidays() -> None:
+    """Expected candles use weekdays and an explicit exchange holiday set."""
+    assert expected_trading_days(
+        date(2024, 1, 25),
+        date(2024, 1, 30),
+        holidays=(date(2024, 1, 26),),
+    ) == (date(2024, 1, 25), date(2024, 1, 29), date(2024, 1, 30))
+
+
+def test_missing_candle_check_reports_machine_readable_dates() -> None:
+    """Missing expected days are represented by a structured error."""
+    issues = check_missing_candles(
+        _frame(),
+        (date(2024, 1, 2), date(2024, 1, 3), date(2024, 1, 4)),
+    )
+    assert len(issues) == 1
+    assert issues[0].check == "missing_candles"
+    assert issues[0].details["missing_dates"] == [date(2024, 1, 4)]
+
+
+def test_duplicate_check_detects_symbol_date_source_duplicates() -> None:
+    """Duplicate business keys are blocking validation issues."""
+    frame = _frame()
+    issues = check_duplicate_rows(pd.concat([frame, frame.iloc[[0]]], ignore_index=True))
+    assert len(issues) == 1
+    assert issues[0].symbol == "ABC"
+    assert issues[0].date == date(2024, 1, 2)
+
+
+def test_ohlc_check_rejects_invalid_relationships() -> None:
+    """High/low and open/close relationship violations are errors."""
+    frame = _frame()
+    frame.loc[0, "high"] = 8.0
+    issues = check_ohlc(frame)
+    assert len(issues) == 1
+    assert issues[0].severity == "error"
+    assert "high is lower than low" in issues[0].message
+
+
+def test_stale_check_uses_latest_source_timestamp() -> None:
+    """Freshness is evaluated per symbol against the configured clock."""
+    issues = check_stale_data(
+        _frame(),
+        timedelta(hours=1),
+        now=datetime(2024, 1, 4, 2, tzinfo=UTC),
+    )
+    assert len(issues) == 1
+    assert issues[0].check == "stale_data"
+    assert issues[0].details["age_hours"] == 26.0
+
+
+def test_outlier_check_flags_large_return_against_prior_volatility() -> None:
+    """A large close-to-close shock is flagged as a warning."""
+    frame = _frame(("2024-01-02", "2024-01-03", "2024-01-04"))
+    frame.loc[2, "close"] = 100.0
+    issues = check_outliers(frame, return_threshold=0.2, window=20, zscore=6)
+    assert len(issues) == 1
+    assert issues[0].check == "outlier"
+    assert issues[0].severity == "warning"
+    assert issues[0].details["return"] > 0.2
+
+
+def test_validator_returns_json_report_and_raises_on_errors() -> None:
+    """The validator logs findings, returns JSON, and blocks bad data."""
+    frame = _frame()
+    report = MarketDataValidator(ValidationConfig(stale_after_hours=1000)).validate(
+        frame,
+        expected_dates=(date(2024, 1, 2), date(2024, 1, 3)),
+        now=datetime(2024, 1, 3, tzinfo=UTC),
+    )
+    assert isinstance(report, ValidationReport)
+    assert report.passed is True
+    assert report.has_errors is False
+    assert report.has_warnings is False
+    assert report.to_dict()["passed"] is True
+    assert '"issues":[]' in report.to_json()
+    historical_report = MarketDataValidator(ValidationConfig()).validate(
+        frame,
+        expected_dates=(date(2024, 1, 2), date(2024, 1, 3)),
+        now=datetime(2024, 1, 3, tzinfo=UTC),
+        check_stale=False,
+    )
+    assert historical_report.metrics["stale_check_enabled"] is False
+
+    frame.loc[0, "close"] = 999.0
+    with pytest.raises(ValidationError) as error:
+        MarketDataValidator(ValidationConfig(stale_after_hours=1000)).validate_or_raise(
+            frame,
+            expected_dates=(date(2024, 1, 2), date(2024, 1, 3)),
+            now=datetime(2024, 1, 3, tzinfo=UTC),
+        )
+    assert error.value.report.has_errors is True
+
+
+def test_validation_issue_serialization_is_json_compatible() -> None:
+    """Issue and report serialization handles dates and numeric metadata."""
+    issue = ValidationIssue(
+        check="test",
+        severity="warning",
+        message="example",
+        symbol="ABC",
+        date=date(2024, 1, 2),
+        details={"count": 2},
+    )
+    report = ValidationReport(
+        checked_at=datetime(2024, 1, 2, tzinfo=UTC),
+        row_count=1,
+        issues=(issue,),
+    )
+    assert report.has_warnings is True
+    assert report.to_dict()["issues"][0]["date"] == "2024-01-02"
+    assert '"severity":"warning"' in report.to_json()
+
+
+def test_validator_reports_schema_failures_without_raising_directly() -> None:
+    """Schema failures become machine-readable reports for pipeline callers."""
+    frame = _frame().drop(columns=["source"])
+    report = MarketDataValidator(ValidationConfig()).validate(frame)
+    assert report.passed is False
+    assert report.issues[0].check == "schema"
