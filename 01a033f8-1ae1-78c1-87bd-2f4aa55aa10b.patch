@@ -0,0 +1,159 @@
+"""Market-data provider interfaces and the initial yfinance adapter."""
+
+from __future__ import annotations
+
+import logging
+import math
+import time
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from datetime import date, datetime, timedelta
+from typing import Any, Protocol
+
+import pandas as pd
+import yfinance as yf
+
+from .errors import ProviderError
+
+DateLike = date | datetime
+DownloadFunction = Callable[..., Any]
+SleepFunction = Callable[[float], None]
+
+
+class MarketDataProvider(Protocol):
+    """Protocol implemented by historical market-data providers."""
+
+    def download_history(
+        self,
+        provider_symbol: str,
+        start: DateLike,
+        end: DateLike,
+    ) -> pd.DataFrame:
+        """Return daily provider data for an inclusive date range."""
+
+
+def _as_date(value: DateLike, field_name: str) -> date:
+    if isinstance(value, datetime):
+        return value.date()
+    if isinstance(value, date):
+        return value
+    raise ProviderError(f"{field_name} must be a date or datetime")
+
+
+@dataclass(frozen=True, slots=True)
+class YFinanceProvider:
+    """Download daily OHLCV data from yfinance with bounded retries.
+
+    The public date range is inclusive. yfinance treats ``end`` as exclusive,
+    so the adapter advances the end date by one calendar day before making the
+    request. A downloader and sleeper can be injected for deterministic tests.
+    """
+
+    max_attempts: int = 3
+    retry_backoff_seconds: float = 1.0
+    timeout_seconds: float = 30.0
+    auto_adjust: bool = False
+    logger: logging.Logger | None = field(default=None, repr=False, compare=False)
+    downloader: DownloadFunction = field(
+        default_factory=lambda: yf.download,
+        repr=False,
+        compare=False,
+    )
+    sleeper: SleepFunction = field(default=time.sleep, repr=False, compare=False)
+
+    source: str = field(default="yfinance", init=False)
+
+    def __post_init__(self) -> None:
+        if self.max_attempts < 1:
+            raise ValueError("max_attempts must be at least one")
+        if not math.isfinite(self.retry_backoff_seconds) or self.retry_backoff_seconds < 0:
+            raise ValueError("retry_backoff_seconds must be finite and non-negative")
+        if not math.isfinite(self.timeout_seconds) or self.timeout_seconds <= 0:
+            raise ValueError("timeout_seconds must be finite and greater than zero")
+
+    def download_history(
+        self,
+        provider_symbol: str,
+        start: DateLike,
+        end: DateLike,
+    ) -> pd.DataFrame:
+        """Download one daily history, retrying transient provider failures.
+
+        Raises:
+            ProviderError: If the range is invalid, the provider returns no
+                rows, or all retry attempts fail.
+        """
+        if not isinstance(provider_symbol, str) or not provider_symbol.strip():
+            raise ProviderError("provider_symbol must be a non-empty string")
+        start_date = _as_date(start, "start")
+        end_date = _as_date(end, "end")
+        if end_date < start_date:
+            raise ProviderError("end must be on or after start")
+
+        logger = self.logger or logging.getLogger(__name__)
+        last_error: Exception | None = None
+        for attempt in range(1, self.max_attempts + 1):
+            try:
+                frame = self.downloader(
+                    tickers=provider_symbol.strip(),
+                    start=start_date.isoformat(),
+                    end=(end_date + timedelta(days=1)).isoformat(),
+                    auto_adjust=self.auto_adjust,
+                    actions=False,
+                    progress=False,
+                    threads=False,
+                    timeout=self.timeout_seconds,
+                    group_by="column",
+                )
+                if not isinstance(frame, pd.DataFrame) or frame.empty:
+                    raise ProviderError("provider returned no rows")
+                logger.info(
+                    "provider_download_succeeded",
+                    extra={
+                        "operation": "download_history",
+                        "source": self.source,
+                        "symbol": provider_symbol.strip(),
+                        "attempt": attempt,
+                        "rows": len(frame),
+                    },
+                )
+                return frame.copy()
+            except Exception as exc:  # provider libraries expose varied exception types
+                last_error = exc
+                if attempt == self.max_attempts:
+                    break
+                delay = self.retry_backoff_seconds * (2 ** (attempt - 1))
+                logger.warning(
+                    "provider_download_retry",
+                    extra={
+                        "operation": "download_history",
+                        "source": self.source,
+                        "symbol": provider_symbol.strip(),
+                        "attempt": attempt,
+                        "max_attempts": self.max_attempts,
+                        "retry_delay_seconds": delay,
+                        "error": str(exc),
+                    },
+                )
+                if delay:
+                    self.sleeper(delay)
+
+        logger.error(
+            "provider_download_failed",
+            extra={
+                "operation": "download_history",
+                "source": self.source,
+                "symbol": provider_symbol.strip(),
+                "attempts": self.max_attempts,
+                "error": str(last_error),
+            },
+            exc_info=(
+                (type(last_error), last_error, last_error.__traceback__)
+                if last_error is not None
+                else None
+            ),
+        )
+        raise ProviderError(
+            f"failed to download {provider_symbol.strip()} after {self.max_attempts} attempt(s): "
+            f"{last_error}"
+        ) from last_error
