@@ -0,0 +1,525 @@
+"""Schema, completeness, integrity, freshness, and outlier validation."""
+
+from __future__ import annotations
+
+import json
+import logging
+import math
+from collections.abc import Iterable, Mapping
+from dataclasses import dataclass, field
+from datetime import UTC, date, datetime, timedelta
+from numbers import Integral, Real
+from typing import Any
+
+import pandas as pd
+
+try:
+    import pandera.pandas as pa
+except ImportError:  # Pandera versions before the pandas-specific namespace
+    import pandera as pa
+from pandera.errors import SchemaError, SchemaErrors
+
+from config.settings import ValidationConfig
+
+from .errors import ValidationError
+from .normalization import CANONICAL_COLUMNS
+
+DateLike = date | datetime
+_REQUIRED_VALIDATION_COLUMNS = frozenset(CANONICAL_COLUMNS)
+
+
+def _json_safe(value: Any) -> Any:
+    if isinstance(value, datetime | pd.Timestamp):
+        timestamp = pd.Timestamp(value)
+        if timestamp.tzinfo is None:
+            return timestamp.isoformat()
+        return timestamp.isoformat()
+    if isinstance(value, date):
+        return value.isoformat()
+    if isinstance(value, Mapping):
+        return {str(key): _json_safe(item) for key, item in value.items()}
+    if isinstance(value, list | tuple | set):
+        return [_json_safe(item) for item in value]
+    if isinstance(value, Integral) and not isinstance(value, bool):
+        return int(value)
+    if isinstance(value, Real) and not isinstance(value, bool):
+        numeric = float(value)
+        return numeric if math.isfinite(numeric) else None
+    if not isinstance(value, str | bytes | bool | type(None)):
+        missing = pd.isna(value)
+        if isinstance(missing, bool) and missing:
+            return None
+    return value
+
+
+def _as_date(value: DateLike) -> date:
+    if isinstance(value, datetime):
+        return value.date()
+    if isinstance(value, date):
+        return value
+    raise ValueError("expected a date or datetime")
+
+
+def _as_utc(value: datetime | None) -> datetime:
+    timestamp = value or datetime.now(UTC)
+    if timestamp.tzinfo is None:
+        return timestamp.replace(tzinfo=UTC)
+    return timestamp.astimezone(UTC)
+
+
+def _row_date(row: pd.Series) -> date | None:
+    value = row.get("date")
+    if value is None or pd.isna(value):
+        return None
+    try:
+        return pd.Timestamp(value).date()
+    except (TypeError, ValueError):
+        return None
+
+
+def _schema() -> pa.DataFrameSchema:
+    return pa.DataFrameSchema(
+        {
+            "date": pa.Column(pa.DateTime, nullable=False),
+            "symbol": pa.Column(str, nullable=False),
+            "exchange": pa.Column(str, nullable=False),
+            "open": pa.Column(float, nullable=True),
+            "high": pa.Column(float, nullable=True),
+            "low": pa.Column(float, nullable=True),
+            "close": pa.Column(float, nullable=True),
+            "adj_close": pa.Column(float, nullable=True),
+            "volume": pa.Column(float, nullable=True),
+            "source": pa.Column(str, nullable=False),
+            # Pandera's DateTime dtype does not accept all timezone-aware
+            # pandas versions; timestamp parsing is checked by the stale check.
+            "source_timestamp": pa.Column(nullable=False),
+            "ingestion_timestamp": pa.Column(nullable=False),
+            "adjustment_status": pa.Column(str, nullable=False),
+        },
+        strict=False,
+        coerce=False,
+    )
+
+
+def _check_metadata_timestamps(frame: pd.DataFrame) -> tuple[ValidationIssue, ...]:
+    issues: list[ValidationIssue] = []
+    for column in ("source_timestamp", "ingestion_timestamp"):
+        parsed = pd.to_datetime(frame[column], errors="coerce", utc=True)
+        invalid_count = int(parsed.isna().sum())
+        if invalid_count:
+            issues.append(
+                ValidationIssue(
+                    check="metadata_timestamps",
+                    severity="error",
+                    message=f"{column} contains invalid timestamps",
+                    details={"column": column, "invalid_count": invalid_count},
+                )
+            )
+    return tuple(issues)
+
+
+@dataclass(frozen=True, slots=True)
+class ValidationIssue:
+    """One machine-readable validation finding."""
+
+    check: str
+    severity: str
+    message: str
+    symbol: str | None = None
+    date: date | None = None
+    details: Mapping[str, Any] = field(default_factory=dict)
+
+    def __post_init__(self) -> None:
+        if self.severity not in {"error", "warning"}:
+            raise ValueError("severity must be error or warning")
+        if not self.check.strip() or not self.message.strip():
+            raise ValueError("check and message must be non-empty")
+
+    def to_dict(self) -> dict[str, Any]:
+        """Return a JSON-compatible representation of the issue."""
+        return {
+            "check": self.check,
+            "severity": self.severity,
+            "message": self.message,
+            "symbol": self.symbol,
+            "date": self.date.isoformat() if self.date else None,
+            "details": _json_safe(dict(self.details)),
+        }
+
+
+@dataclass(frozen=True, slots=True)
+class ValidationReport:
+    """Complete result of one validation run."""
+
+    checked_at: datetime
+    row_count: int
+    issues: tuple[ValidationIssue, ...]
+    metrics: Mapping[str, Any] = field(default_factory=dict)
+
+    @property
+    def passed(self) -> bool:
+        """Whether the report contains no blocking errors."""
+        return not self.has_errors
+
+    @property
+    def has_errors(self) -> bool:
+        """Whether at least one error-severity issue was found."""
+        return any(issue.severity == "error" for issue in self.issues)
+
+    @property
+    def has_warnings(self) -> bool:
+        """Whether at least one warning-severity issue was found."""
+        return any(issue.severity == "warning" for issue in self.issues)
+
+    def to_dict(self) -> dict[str, Any]:
+        """Return a machine-readable report mapping."""
+        return {
+            "checked_at": _json_safe(self.checked_at),
+            "row_count": self.row_count,
+            "passed": self.passed,
+            "issues": [issue.to_dict() for issue in self.issues],
+            "metrics": _json_safe(dict(self.metrics)),
+        }
+
+    def to_json(self) -> str:
+        """Serialize the report deterministically as JSON."""
+        return json.dumps(self.to_dict(), sort_keys=True, separators=(",", ":"))
+
+
+def expected_trading_days(
+    start: DateLike,
+    end: DateLike,
+    holidays: Iterable[date] = (),
+) -> tuple[date, ...]:
+    """Return inclusive Monday-Friday dates excluding configured holidays.
+
+    This deliberately uses an explicit holiday set rather than pretending that
+    a generic business-day calendar knows every exchange holiday. Deployments
+    should provide the appropriate exchange holiday dates in configuration.
+    """
+    start_date = _as_date(start)
+    end_date = _as_date(end)
+    if end_date < start_date:
+        raise ValueError("end must be on or after start")
+    excluded = {_as_date(value) for value in holidays}
+    result: list[date] = []
+    current = start_date
+    while current <= end_date:
+        if current.weekday() < 5 and current not in excluded:
+            result.append(current)
+        current += timedelta(days=1)
+    return tuple(result)
+
+
+def check_missing_candles(
+    frame: pd.DataFrame,
+    expected_dates: Iterable[DateLike],
+) -> tuple[ValidationIssue, ...]:
+    """Detect expected trading dates absent for each symbol in a frame."""
+    expected = {_as_date(value) for value in expected_dates}
+    if not expected:
+        return ()
+    observed_dates = pd.to_datetime(frame["date"], errors="coerce").dt.date
+    issues: list[ValidationIssue] = []
+    for symbol in sorted(frame["symbol"].dropna().astype(str).unique()):
+        observed = set(observed_dates[frame["symbol"].astype(str) == symbol].dropna())
+        missing = sorted(expected - observed)
+        if missing:
+            issues.append(
+                ValidationIssue(
+                    check="missing_candles",
+                    severity="error",
+                    message=f"{len(missing)} expected trading day(s) are absent",
+                    symbol=symbol,
+                    details={
+                        "missing_dates": missing,
+                        "expected_count": len(expected),
+                        "observed_count": len(observed),
+                    },
+                )
+            )
+    return tuple(issues)
+
+
+def check_duplicate_rows(frame: pd.DataFrame) -> tuple[ValidationIssue, ...]:
+    """Detect duplicate ``(symbol, date, source)`` records."""
+    required = {"symbol", "date", "source"}
+    missing = required - set(frame.columns)
+    if missing:
+        raise ValueError("duplicate check requires columns: " + ", ".join(sorted(missing)))
+    duplicate_mask = frame.duplicated(subset=["symbol", "date", "source"], keep=False)
+    duplicates = frame.loc[duplicate_mask, ["symbol", "date", "source"]].drop_duplicates()
+    return tuple(
+        ValidationIssue(
+            check="duplicate_rows",
+            severity="error",
+            message="duplicate symbol/date/source record",
+            symbol=str(row.symbol),
+            date=_row_date(row),
+            details={"source": row.source},
+        )
+        for row in (duplicate_row for _, duplicate_row in duplicates.iterrows())
+    )
+
+
+def check_ohlc(frame: pd.DataFrame) -> tuple[ValidationIssue, ...]:
+    """Detect null, non-finite, negative-volume, and invalid OHLC relationships."""
+    required = {"symbol", "date", "open", "high", "low", "close", "volume"}
+    missing = required - set(frame.columns)
+    if missing:
+        raise ValueError("OHLC check requires columns: " + ", ".join(sorted(missing)))
+    issues: list[ValidationIssue] = []
+    for _, row in frame.iterrows():
+        values = {
+            name: pd.to_numeric(row[name], errors="coerce")
+            for name in ("open", "high", "low", "close", "volume")
+        }
+        reasons: list[str] = []
+        if any(pd.isna(value) or not math.isfinite(float(value)) for value in values.values()):
+            reasons.append("OHLCV contains a null or non-finite value")
+        else:
+            if values["high"] < values["low"]:
+                reasons.append("high is lower than low")
+            if not values["low"] <= values["open"] <= values["high"]:
+                reasons.append("open is outside low/high")
+            if not values["low"] <= values["close"] <= values["high"]:
+                reasons.append("close is outside low/high")
+            if values["volume"] < 0:
+                reasons.append("volume is negative")
+        if reasons:
+            issues.append(
+                ValidationIssue(
+                    check="ohlc",
+                    severity="error",
+                    message="; ".join(reasons),
+                    symbol=str(row["symbol"]),
+                    date=_row_date(row),
+                    details={name: values[name] for name in values},
+                )
+            )
+    return tuple(issues)
+
+
+def check_stale_data(
+    frame: pd.DataFrame,
+    max_age: timedelta,
+    now: datetime | None = None,
+) -> tuple[ValidationIssue, ...]:
+    """Detect symbols whose newest source timestamp exceeds ``max_age``."""
+    if max_age <= timedelta(0):
+        raise ValueError("max_age must be greater than zero")
+    required = {"symbol", "source_timestamp", "date"}
+    missing = required - set(frame.columns)
+    if missing:
+        raise ValueError("stale check requires columns: " + ", ".join(sorted(missing)))
+    current = _as_utc(now)
+    timestamps = pd.to_datetime(frame["source_timestamp"], errors="coerce", utc=True)
+    issues: list[ValidationIssue] = []
+    for symbol in sorted(frame["symbol"].dropna().astype(str).unique()):
+        symbol_timestamps = timestamps[frame["symbol"].astype(str) == symbol].dropna()
+        if symbol_timestamps.empty:
+            issues.append(
+                ValidationIssue(
+                    check="stale_data",
+                    severity="error",
+                    message="symbol has no valid source timestamp",
+                    symbol=symbol,
+                )
+            )
+            continue
+        latest = symbol_timestamps.max().to_pydatetime()
+        age = current - latest
+        if age > max_age:
+            issues.append(
+                ValidationIssue(
+                    check="stale_data",
+                    severity="error",
+                    message=f"latest data is {age.total_seconds() / 3600:.2f} hours old",
+                    symbol=symbol,
+                    date=latest.date(),
+                    details={
+                        "latest_source_timestamp": latest,
+                        "age_hours": age.total_seconds() / 3600,
+                        "max_age_hours": max_age.total_seconds() / 3600,
+                    },
+                )
+            )
+    return tuple(issues)
+
+
+def check_outliers(
+    frame: pd.DataFrame,
+    return_threshold: float,
+    window: int,
+    zscore: float,
+) -> tuple[ValidationIssue, ...]:
+    """Flag extreme close-to-close returns against rolling volatility."""
+    if not math.isfinite(return_threshold) or not 0 < return_threshold < 1:
+        raise ValueError("return_threshold must be finite and between zero and one")
+    if window < 2 or not math.isfinite(zscore) or zscore <= 0:
+        raise ValueError("window must be at least two and zscore must be positive")
+    required = {"symbol", "date", "close"}
+    missing = required - set(frame.columns)
+    if missing:
+        raise ValueError("outlier check requires columns: " + ", ".join(sorted(missing)))
+
+    working = frame.loc[:, ["symbol", "date", "close"]].copy()
+    working["_date"] = pd.to_datetime(working["date"], errors="coerce")
+    working["_close"] = pd.to_numeric(working["close"], errors="coerce")
+    working = working.sort_values(["symbol", "_date"], kind="stable")
+    issues: list[ValidationIssue] = []
+    for symbol, group in working.groupby("symbol", sort=True):
+        returns = group["_close"].pct_change()
+        # Compare today's return with volatility known before today's close;
+        # including the return being tested would dilute a one-day shock.
+        volatility = returns.shift(1).rolling(window=window, min_periods=2).std()
+        limit = (volatility * zscore).fillna(return_threshold).clip(lower=return_threshold)
+        outlier_mask = returns.abs() > limit
+        for index in outlier_mask[outlier_mask.fillna(False)].index:
+            row = group.loc[index]
+            movement = float(returns.loc[index])
+            rolling_volatility = volatility.loc[index]
+            issues.append(
+                ValidationIssue(
+                    check="outlier",
+                    severity="warning",
+                    message=f"close return {movement:.4f} exceeds volatility threshold",
+                    symbol=str(symbol),
+                    date=row["_date"].date() if pd.notna(row["_date"]) else None,
+                    details={
+                        "return": movement,
+                        "rolling_volatility": rolling_volatility,
+                        "threshold": float(limit.loc[index]),
+                        "window": window,
+                        "zscore": zscore,
+                    },
+                )
+            )
+    return tuple(issues)
+
+
+@dataclass(slots=True)
+class MarketDataValidator:
+    """Run all configured market-data checks and emit structured findings."""
+
+    config: ValidationConfig
+    logger: logging.Logger | None = None
+
+    def validate(
+        self,
+        frame: pd.DataFrame,
+        expected_dates: Iterable[DateLike] | None = None,
+        now: datetime | None = None,
+        check_stale: bool = True,
+    ) -> ValidationReport:
+        """Validate a canonical frame and return all findings without hiding failures.
+
+        ``check_stale=False`` is intended for historical backfills where the
+        requested end date is intentionally older than the validation clock.
+        """
+        checked_at = _as_utc(now)
+        issues: list[ValidationIssue] = []
+        metrics: dict[str, Any] = {
+            "row_count": len(frame) if isinstance(frame, pd.DataFrame) else 0
+        }
+        if not isinstance(frame, pd.DataFrame):
+            issues.append(ValidationIssue("schema", "error", "input is not a pandas DataFrame"))
+        else:
+            missing = _REQUIRED_VALIDATION_COLUMNS - set(frame.columns)
+            if missing:
+                issues.append(
+                    ValidationIssue(
+                        "schema",
+                        "error",
+                        "canonical columns are missing",
+                        details={"missing_columns": sorted(missing)},
+                    )
+                )
+            else:
+                try:
+                    _schema().validate(frame, lazy=True)
+                except (SchemaError, SchemaErrors) as exc:
+                    issues.append(
+                        ValidationIssue(
+                            "schema",
+                            "error",
+                            "canonical schema validation failed",
+                            details={"error": str(exc)},
+                        )
+                    )
+                issues.extend(_check_metadata_timestamps(frame))
+                if frame.empty:
+                    issues.append(ValidationIssue("schema", "error", "market-data frame is empty"))
+                else:
+                    if expected_dates is None:
+                        valid_dates = pd.to_datetime(frame["date"], errors="coerce").dropna()
+                        if not valid_dates.empty:
+                            expected_dates = expected_trading_days(
+                                valid_dates.min().date(),
+                                valid_dates.max().date(),
+                                self.config.holidays,
+                            )
+                    if expected_dates is not None:
+                        issues.extend(check_missing_candles(frame, expected_dates))
+                    issues.extend(check_duplicate_rows(frame))
+                    issues.extend(check_ohlc(frame))
+                    if check_stale:
+                        issues.extend(
+                            check_stale_data(
+                                frame,
+                                timedelta(hours=self.config.stale_after_hours),
+                                now=checked_at,
+                            )
+                        )
+                    issues.extend(
+                        check_outliers(
+                            frame,
+                            self.config.outlier_return_threshold,
+                            self.config.outlier_window,
+                            self.config.outlier_zscore,
+                        )
+                    )
+                    valid_dates = pd.to_datetime(frame["date"], errors="coerce").dropna()
+                    metrics.update(
+                        {
+                            "symbol_count": int(frame["symbol"].nunique(dropna=True)),
+                            "min_date": valid_dates.min() if not valid_dates.empty else None,
+                            "max_date": valid_dates.max() if not valid_dates.empty else None,
+                        }
+                    )
+        metrics["stale_check_enabled"] = check_stale
+        metrics["error_count"] = sum(issue.severity == "error" for issue in issues)
+        metrics["warning_count"] = sum(issue.severity == "warning" for issue in issues)
+        report = ValidationReport(checked_at, metrics["row_count"], tuple(issues), metrics)
+        logger = self.logger or logging.getLogger(__name__)
+        for issue in report.issues:
+            logger.log(
+                logging.ERROR if issue.severity == "error" else logging.WARNING,
+                "validation_issue",
+                extra={
+                    "operation": "validate",
+                    "symbol": issue.symbol,
+                    "date": issue.date,
+                    "check": issue.check,
+                    "details": dict(issue.details),
+                },
+            )
+        return report
+
+    def validate_or_raise(
+        self,
+        frame: pd.DataFrame,
+        expected_dates: Iterable[DateLike] | None = None,
+        now: datetime | None = None,
+        check_stale: bool = True,
+    ) -> ValidationReport:
+        """Validate a frame and raise :class:`ValidationError` on errors."""
+        report = self.validate(
+            frame,
+            expected_dates=expected_dates,
+            now=now,
+            check_stale=check_stale,
+        )
+        if report.has_errors:
+            raise ValidationError(report)
+        return report
