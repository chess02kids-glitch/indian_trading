@@ -0,0 +1,167 @@
+"""Tests for the end-to-end ingestion pipeline and configured factory."""
+
+from __future__ import annotations
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from config.settings import (
+    IngestionConfig,
+    LoggingConfig,
+    Settings,
+    StorageConfig,
+    UniverseConfig,
+    UniverseEntry,
+    ValidationConfig,
+)
+from ingestion.database import DuckDBManager
+from ingestion.errors import IngestionBatchError, ProviderError, ValidationError
+from ingestion.factory import build_ingestor
+from ingestion.pipeline import MarketDataIngestor
+from ingestion.storage import ParquetStorage
+from ingestion.validation import MarketDataValidator
+
+
+class _StubProvider:
+    """Small provider double returning a deterministic two-day response."""
+
+    source = "stub"
+
+    def __init__(self, frame: pd.DataFrame) -> None:
+        self.frame = frame
+        self.calls: list[tuple[str, object, object]] = []
+
+    def download_history(self, provider_symbol, start, end) -> pd.DataFrame:
+        self.calls.append((provider_symbol, start, end))
+        return self.frame.copy()
+
+
+class _FailingProvider:
+    """Provider double that makes the pipeline exercise failure handling."""
+
+    source = "stub"
+
+    def download_history(self, provider_symbol, start, end) -> pd.DataFrame:
+        raise ProviderError("download failed")
+
+
+def _ingestor(tmp_path: Path, provider) -> MarketDataIngestor:
+    """Build a pipeline with deterministic time and temporary storage."""
+    now = datetime(2024, 1, 3, tzinfo=UTC)
+    return MarketDataIngestor(
+        provider=provider,
+        storage=ParquetStorage(tmp_path / "raw"),
+        database=DuckDBManager(tmp_path / "catalog.duckdb"),
+        validator=MarketDataValidator(ValidationConfig(stale_after_hours=1000)),
+        source="stub",
+        clock=lambda: now,
+    )
+
+
+def test_ingest_symbol_downloads_validates_stores_and_registers(tmp_path: Path, raw_frame) -> None:
+    """A successful ingestion reaches DuckDB only after validation and storage."""
+    provider = _StubProvider(raw_frame)
+    ingestor = _ingestor(tmp_path, provider)
+    result = ingestor.ingest_symbol(
+        UniverseEntry("ABC", "NSE"),
+        date(2024, 1, 2),
+        date(2024, 1, 3),
+    )
+    assert result.row_count == 2
+    assert result.validation.passed is True
+    assert len(result.written_partitions) == 1
+    assert result.registration.row_count == 2
+    assert ingestor.database.query_scalar("SELECT COUNT(*) FROM market_data") == 2
+    assert provider.calls[0][0] == "ABC.NS"
+
+
+def test_ingest_symbol_does_not_write_when_provider_fails(tmp_path: Path, raw_frame) -> None:
+    """Provider failures propagate and leave the raw directory untouched."""
+    ingestor = _ingestor(tmp_path, _FailingProvider())
+    with pytest.raises(ProviderError, match="download failed"):
+        ingestor.ingest_symbol(
+            UniverseEntry("ABC", "NSE"),
+            date(2024, 1, 2),
+            date(2024, 1, 3),
+        )
+    assert not (tmp_path / "raw").exists()
+
+
+def test_ingest_symbol_refreshes_global_analytical_view(tmp_path: Path, raw_frame) -> None:
+    """Registering another symbol preserves earlier symbols in market_data."""
+    provider = _StubProvider(raw_frame)
+    ingestor = _ingestor(tmp_path, provider)
+    for symbol in ("ABC", "XYZ"):
+        ingestor.ingest_symbol(
+            UniverseEntry(symbol, "NSE"),
+            date(2024, 1, 2),
+            date(2024, 1, 3),
+        )
+    assert ingestor.database.query_scalar("SELECT COUNT(*) FROM market_data") == 4
+
+
+def test_ingest_symbol_blocks_invalid_data_before_storage(tmp_path: Path, raw_frame) -> None:
+    """Validation failures prevent both Parquet writes and catalog updates."""
+    invalid = raw_frame.copy()
+    invalid.loc[invalid.index[0], "High"] = 1.0
+    ingestor = _ingestor(tmp_path, _StubProvider(invalid))
+    with pytest.raises(ValidationError) as error:
+        ingestor.ingest_symbol(
+            UniverseEntry("ABC", "NSE"),
+            date(2024, 1, 2),
+            date(2024, 1, 3),
+        )
+    assert error.value.report.has_errors is True
+    assert not (tmp_path / "raw").exists()
+
+
+def test_historical_ingestion_skips_current_freshness_check(tmp_path: Path, raw_frame) -> None:
+    """Backfills do not fail solely because their requested dates are historical."""
+    ingestor = MarketDataIngestor(
+        provider=_StubProvider(raw_frame),
+        storage=ParquetStorage(tmp_path / "raw"),
+        database=DuckDBManager(tmp_path / "catalog.duckdb"),
+        validator=MarketDataValidator(ValidationConfig()),
+        source="stub",
+        clock=lambda: datetime(2025, 1, 1, tzinfo=UTC),
+    )
+    result = ingestor.ingest_symbol(
+        UniverseEntry("ABC", "NSE"),
+        date(2024, 1, 2),
+        date(2024, 1, 3),
+    )
+    assert result.validation.metrics["stale_check_enabled"] is False
+
+
+def test_ingest_universe_reports_all_symbol_failures(tmp_path: Path) -> None:
+    """Batch mode does not hide failures behind successful symbols."""
+    ingestor = _ingestor(tmp_path, _FailingProvider())
+    universe = UniverseConfig(symbols=(UniverseEntry("ABC", "NSE"),))
+    with pytest.raises(IngestionBatchError) as error:
+        ingestor.ingest_universe(universe, date(2024, 1, 2), date(2024, 1, 3))
+    assert "NSE:ABC" in error.value.failures
+
+
+def test_build_ingestor_wires_configured_components(tmp_path: Path) -> None:
+    """The factory wires settings without contacting an external provider."""
+    settings = Settings(
+        universe=UniverseConfig(),
+        storage=StorageConfig(data_root=tmp_path / "data"),
+        validation=ValidationConfig(),
+        logging=LoggingConfig(logger_name="quant-india-factory-test"),
+        ingestion=IngestionConfig(max_attempts=2),
+    )
+    ingestor = build_ingestor(settings)
+    assert isinstance(ingestor.storage, ParquetStorage)
+    assert isinstance(ingestor.database, DuckDBManager)
+    assert ingestor.source == "yfinance"
+    ingestor.database.close()
+
+
+def test_build_ingestor_rejects_wrong_settings_type() -> None:
+    """Factory configuration errors are explicit rather than attribute errors."""
+    with pytest.raises(TypeError, match="Settings"):
+        build_ingestor(object())
