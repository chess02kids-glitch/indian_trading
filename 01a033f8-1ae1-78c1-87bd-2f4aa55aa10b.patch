--- /dev/null
+++ b/ingestion/storage.py
@@ -0,0 +1,233 @@
+"""Immutable monthly Parquet storage for canonical market candles."""
+
+from __future__ import annotations
+
+import logging
+import os
+import re
+from contextlib import suppress
+from dataclasses import dataclass, field
+from pathlib import Path
+from uuid import uuid4
+
+import pandas as pd
+
+from .errors import ImmutablePartitionError, StorageError
+from .normalization import CANONICAL_COLUMNS
+
+_SAFE_PATH_SEGMENT = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
+
+
+@dataclass(frozen=True, slots=True)
+class PartitionWriteResult:
+    """Outcome of an immutable write operation."""
+
+    written: tuple[Path, ...]
+    skipped: tuple[Path, ...]
+
+
+@dataclass(slots=True)
+class ParquetStorage:
+    """Write and read monthly raw-data partitions without destructive updates."""
+
+    root: Path
+    logger: logging.Logger | None = field(default=None, repr=False)
+
+    def __post_init__(self) -> None:
+        self.root = Path(self.root).expanduser()
+
+    @staticmethod
+    def _safe_segment(value: str, field_name: str) -> str:
+        if not isinstance(value, str) or not value or not _SAFE_PATH_SEGMENT.fullmatch(value):
+            raise StorageError(f"{field_name} is not a safe partition path segment: {value!r}")
+        return value
+
+    def partition_path(
+        self,
+        source: str,
+        exchange: str,
+        symbol: str,
+        year: int,
+        month: int,
+    ) -> Path:
+        """Return the required source/exchange/symbol/year/month partition path."""
+        if not isinstance(year, int) or not 1 <= year <= 9999:
+            raise StorageError("year must be between 1 and 9999")
+        if not isinstance(month, int) or not 1 <= month <= 12:
+            raise StorageError("month must be between 1 and 12")
+        return (
+            self.root
+            / self._safe_segment(source, "source")
+            / self._safe_segment(exchange, "exchange")
+            / self._safe_segment(symbol, "symbol")
+            / f"{year:04d}"
+            / f"{month:02d}.parquet"
+        )
+
+    @staticmethod
+    def _canonical_for_comparison(frame: pd.DataFrame) -> pd.DataFrame:
+        comparable = frame.drop(columns=["ingestion_timestamp"], errors="ignore").copy()
+        columns = [column for column in CANONICAL_COLUMNS if column in comparable.columns]
+        return (
+            comparable[columns]
+            .sort_values(
+                ["date", "source_timestamp", "symbol", "exchange", "source"],
+                kind="stable",
+            )
+            .reset_index(drop=True)
+        )
+
+    def _is_identical_partition(self, candidate: pd.DataFrame, existing_path: Path) -> bool:
+        try:
+            existing = pd.read_parquet(existing_path)
+            if set(existing.columns) != set(CANONICAL_COLUMNS):
+                return False
+            pd.testing.assert_frame_equal(
+                self._canonical_for_comparison(candidate),
+                self._canonical_for_comparison(existing),
+                check_dtype=False,
+                check_index_type=False,
+                check_column_type=False,
+            )
+        except (AssertionError, KeyError, OSError, ValueError, TypeError):
+            return False
+        return True
+
+    def _write_new_partition(self, frame: pd.DataFrame, path: Path) -> bool:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        temporary_path = path.parent / f".{path.name}.{uuid4().hex}.tmp"
+        try:
+            frame.to_parquet(temporary_path, index=False, engine="pyarrow", compression="snappy")
+            try:
+                # link() is an atomic create and cannot replace an existing file.
+                os.link(temporary_path, path)
+                return True
+            except FileExistsError as exc:
+                if self._is_identical_partition(frame, path):
+                    return False
+                raise ImmutablePartitionError(
+                    f"immutable partition changed while writing: {path}"
+                ) from exc
+        except ImmutablePartitionError:
+            raise
+        except (OSError, ValueError, TypeError) as exc:
+            raise StorageError(f"failed to write Parquet partition: {path}") from exc
+        finally:
+            with suppress(FileNotFoundError):
+                temporary_path.unlink()
+
+    def write_immutable(self, frame: pd.DataFrame) -> PartitionWriteResult:
+        """Write canonical candles into immutable monthly Parquet partitions.
+
+        Existing partitions are never overwritten. A byte-different or
+        semantically different existing partition raises
+        :class:`ImmutablePartitionError`; an identical retry is explicitly
+        reported as skipped. New files are created through an atomic exclusive
+        link after being fully written to a temporary sibling.
+        """
+        if not isinstance(frame, pd.DataFrame) or frame.empty:
+            raise StorageError("cannot write an empty market-data frame")
+        missing = [column for column in CANONICAL_COLUMNS if column not in frame.columns]
+        if missing:
+            raise StorageError("cannot write frame missing columns: " + ", ".join(missing))
+
+        working = frame.loc[:, list(CANONICAL_COLUMNS)].copy()
+        dates = pd.to_datetime(working["date"], errors="coerce", utc=True)
+        if dates.isna().any():
+            raise StorageError("cannot partition rows with invalid dates")
+        for column in ("source", "exchange", "symbol"):
+            if working[column].isna().any() or (working[column].astype(str).str.len() == 0).any():
+                raise StorageError(f"cannot partition rows with empty {column}")
+        working["_year"] = dates.dt.year.astype(int)
+        working["_month"] = dates.dt.month.astype(int)
+
+        groups: list[tuple[Path, pd.DataFrame]] = []
+        grouped = working.groupby(
+            ["source", "exchange", "symbol", "_year", "_month"],
+            sort=True,
+            dropna=False,
+        )
+        for (source, exchange, symbol, year, month), group in grouped:
+            path = self.partition_path(
+                str(source),
+                str(exchange),
+                str(symbol),
+                int(year),
+                int(month),
+            )
+            partition = (
+                group.drop(columns=["_year", "_month"])
+                .sort_values(["date", "source_timestamp"], kind="stable")
+                .reset_index(drop=True)
+            )
+            groups.append((path, partition))
+
+        skipped: list[Path] = []
+        for path, partition in groups:
+            if path.exists():
+                if self._is_identical_partition(partition, path):
+                    skipped.append(path)
+                    (self.logger or logging.getLogger(__name__)).info(
+                        "immutable_partition_exists",
+                        extra={
+                            "operation": "write_immutable",
+                            "source": str(partition["source"].iloc[0]),
+                            "exchange": str(partition["exchange"].iloc[0]),
+                            "symbol": str(partition["symbol"].iloc[0]),
+                            "partition": str(path),
+                        },
+                    )
+                    continue
+                raise ImmutablePartitionError(f"refusing to overwrite immutable partition: {path}")
+
+        written: list[Path] = []
+        for path, partition in groups:
+            if path in skipped:
+                continue
+            if self._write_new_partition(partition, path):
+                written.append(path)
+            else:
+                skipped.append(path)
+        return PartitionWriteResult(tuple(written), tuple(skipped))
+
+    def read_partition(self, path: Path | str) -> pd.DataFrame:
+        """Read one Parquet partition that belongs to this storage root."""
+        candidate = Path(path)
+        if not candidate.is_absolute():
+            candidate = self.root / candidate
+        candidate = candidate.resolve()
+        root = self.root.resolve()
+        if not candidate.is_relative_to(root):
+            raise StorageError(f"partition is outside storage root: {path}")
+        if not candidate.is_file() or candidate.suffix != ".parquet":
+            raise StorageError(f"Parquet partition does not exist: {candidate}")
+        try:
+            return pd.read_parquet(candidate)
+        except (OSError, ValueError, TypeError) as exc:
+            raise StorageError(f"failed to read Parquet partition: {candidate}") from exc
+
+    def list_partitions(
+        self,
+        source: str | None = None,
+        exchange: str | None = None,
+        symbol: str | None = None,
+    ) -> list[Path]:
+        """List stored monthly partitions, optionally filtered by metadata path."""
+        if not self.root.exists():
+            return []
+        result: list[Path] = []
+        for path in self.root.rglob("*.parquet"):
+            try:
+                parts = path.relative_to(self.root).parts
+            except ValueError:
+                continue
+            if len(parts) != 5:
+                continue
+            if source is not None and parts[0] != source:
+                continue
+            if exchange is not None and parts[1] != exchange:
+                continue
+            if symbol is not None and parts[2] != symbol:
+                continue
+            result.append(path)
+        return sorted(result)
