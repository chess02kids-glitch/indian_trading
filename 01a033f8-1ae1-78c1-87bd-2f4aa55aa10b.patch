@@ -0,0 +1,101 @@
+"""Structured JSON logging helpers for ingestion and validation operations."""
+
+from __future__ import annotations
+
+import json
+import logging
+import sys
+from datetime import UTC, datetime
+from typing import Any, TextIO
+
+from config.settings import LoggingConfig
+
+_STANDARD_LOG_RECORD_FIELDS = frozenset(logging.LogRecord("", 0, "", 0, "", (), None).__dict__) | {
+    "message",
+    "asctime",
+}
+
+
+class JsonLogFormatter(logging.Formatter):
+    """Render log records as one machine-readable JSON object per line."""
+
+    def format(self, record: logging.LogRecord) -> str:
+        """Serialize a log record with timestamps and all custom context fields."""
+        payload: dict[str, Any] = {
+            "timestamp": datetime.fromtimestamp(record.created, tz=UTC).isoformat(),
+            "severity": record.levelname,
+            "logger": record.name,
+            "module": record.module,
+            "message": record.getMessage(),
+        }
+        payload.update(
+            {
+                key: value
+                for key, value in record.__dict__.items()
+                if key not in _STANDARD_LOG_RECORD_FIELDS
+            }
+        )
+        if record.exc_info:
+            payload["exception"] = self.formatException(record.exc_info)
+        return json.dumps(payload, default=str, sort_keys=True)
+
+
+class ContextLoggerAdapter(logging.LoggerAdapter[logging.Logger]):
+    """Logger adapter that attaches stable symbol and operation context."""
+
+    def process(self, msg: object, kwargs: dict[str, Any]) -> tuple[object, dict[str, Any]]:
+        """Merge adapter context into the record's ``extra`` mapping."""
+        extra = dict(kwargs.get("extra") or {})
+        extra.update(self.extra)
+        kwargs["extra"] = extra
+        return msg, kwargs
+
+
+def contextual_logger(
+    logger: logging.Logger,
+    *,
+    symbol: str | None = None,
+    exchange: str | None = None,
+    source: str | None = None,
+    operation: str | None = None,
+) -> ContextLoggerAdapter:
+    """Return a logger adapter carrying data-operation context."""
+    context = {
+        key: value
+        for key, value in {
+            "symbol": symbol,
+            "exchange": exchange,
+            "source": source,
+            "operation": operation,
+        }.items()
+        if value is not None
+    }
+    return ContextLoggerAdapter(logger, context)
+
+
+def configure_logging(
+    config: LoggingConfig,
+    stream: TextIO | None = None,
+) -> logging.Logger:
+    """Configure and return the named logger with a JSON or plain handler.
+
+    Existing handlers installed by this function are replaced, making repeated
+    configuration safe in tests and worker initialization. Application-owned
+    handlers are left untouched.
+    """
+    logger = logging.getLogger(config.logger_name)
+    logger.setLevel(config.level)
+    logger.propagate = False
+    for handler in list(logger.handlers):
+        if getattr(handler, "_quant_india_handler", False):
+            logger.removeHandler(handler)
+            handler.close()
+
+    handler = logging.StreamHandler(stream or sys.stderr)
+    handler._quant_india_handler = True  # type: ignore[attr-defined]
+    if config.json_output:
+        handler.setFormatter(JsonLogFormatter())
+    else:
+        handler.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(name)s %(message)s"))
+    logger.addHandler(handler)
+    return logger
