+"""Tests for environment-aware data-foundation configuration."""
+
+from __future__ import annotations
+
+import json
+from datetime import date
+
+import pytest
+
+from config.settings import (
+    ConfigurationError,
+    IngestionConfig,
+    StorageConfig,
+    UniverseConfig,
+    UniverseEntry,
+    ValidationConfig,
+    load_settings,
+)
+
+
+def test_universe_entry_derives_yfinance_ticker() -> None:
+    """NSE and BSE entries receive the provider's exchange suffix."""
+    assert UniverseEntry("reliance", "nse").ticker == "RELIANCE.NS"
+    assert UniverseEntry("TCS", "BSE").ticker == "TCS.BO"
+
+
+def test_universe_entry_accepts_explicit_provider_symbol() -> None:
+    """Explicit tickers support instruments with provider-specific naming."""
+    entry = UniverseEntry("NIFTY", "NSE", provider_symbol="^NSEI")
+    assert entry.ticker == "^NSEI"
+
+
+def test_universe_config_rejects_duplicates_and_unsupported_exchanges() -> None:
+    """Universe validation prevents ambiguous or unapproved instruments."""
+    with pytest.raises(ConfigurationError, match="duplicate"):
+        UniverseConfig(
+            symbols=(UniverseEntry("ABC", "NSE"), UniverseEntry("ABC", "NSE")),
+        )
+    with pytest.raises(ConfigurationError, match="not supported"):
+        UniverseConfig(
+            symbols=(UniverseEntry("ABC", "BSE"),),
+            supported_exchanges=("NSE",),
+        )
+
+
+def test_universe_config_loads_json_file(tmp_path) -> None:
+    """Universe files provide symbols and supported exchange settings."""
+    path = tmp_path / "universe.json"
+    path.write_text(
+        json.dumps(
+            {
+                "supported_exchanges": ["NSE"],
+                "symbols": [{"symbol": "ABC", "exchange": "NSE"}],
+            }
+        ),
+        encoding="utf-8",
+    )
+    config = UniverseConfig.from_file(path)
+    assert config.symbols[0].ticker == "ABC.NS"
+    assert config.supported_exchanges == ("NSE",)
+
+
+def test_load_settings_honors_supported_exchanges_from_file(tmp_path) -> None:
+    """The file allow-list is retained when no environment override exists."""
+    path = tmp_path / "universe.json"
+    path.write_text(
+        json.dumps(
+            {
+                "supported_exchanges": ["NSE"],
+                "symbols": [{"symbol": "ABC", "exchange": "NSE"}],
+            }
+        ),
+        encoding="utf-8",
+    )
+    settings = load_settings({}, universe_file=path)
+    assert settings.universe.supported_exchanges == ("NSE",)
+
+
+def test_load_settings_reads_environment_and_universe_json() -> None:
+    """Namespaced environment variables override safe defaults."""
+    settings = load_settings(
+        {
+            "QUANT_INDIA_UNIVERSE_JSON": json.dumps(
+                {"symbols": [{"symbol": "ABC", "exchange": "NSE"}]}
+            ),
+            "QUANT_INDIA_DATA_ROOT": "/tmp/quant-data",
+            "QUANT_INDIA_STALE_AFTER_HOURS": "48",
+            "QUANT_INDIA_OUTLIER_WINDOW": "10",
+            "QUANT_INDIA_LOG_LEVEL": "debug",
+            "QUANT_INDIA_LOG_JSON": "false",
+            "QUANT_INDIA_MAX_ATTEMPTS": "4",
+            "QUANT_INDIA_AUTO_ADJUST": "true",
+            "QUANT_INDIA_HOLIDAYS": "2024-01-26,2024-08-15",
+            "QUANT_INDIA_TIMEZONE": "UTC",
+        }
+    )
+    assert settings.storage.raw_root == settings.storage.data_root / "raw"
+    assert settings.storage.clean_root == settings.storage.data_root / "clean"
+    assert settings.storage.features_root == settings.storage.data_root / "features"
+    assert settings.storage.snapshots_root == settings.storage.data_root / "snapshots"
+    assert settings.storage.duckdb_path == settings.storage.data_root / "quant_india.duckdb"
+    assert settings.validation.stale_after_hours == 48
+    assert settings.validation.outlier_window == 10
+    assert settings.validation.holidays == (date(2024, 1, 26), date(2024, 8, 15))
+    assert settings.logging.level == "DEBUG"
+    assert settings.logging.json_output is False
+    assert settings.ingestion.max_attempts == 4
+    assert settings.ingestion.auto_adjust is True
+    assert settings.timezone == "UTC"
+    assert settings.universe.symbols[0].ticker == "ABC.NS"
+
+
+def test_load_settings_rejects_invalid_environment_values() -> None:
+    """Malformed deployment values fail at configuration load time."""
+    with pytest.raises(ConfigurationError, match="boolean"):
+        load_settings(
+            {
+                "QUANT_INDIA_UNIVERSE_JSON": '{"symbols": []}',
+                "QUANT_INDIA_LOG_JSON": "sometimes",
+            }
+        )
+    with pytest.raises(ConfigurationError, match="holiday"):
+        load_settings(
+            {
+                "QUANT_INDIA_UNIVERSE_JSON": '{"symbols": []}',
+                "QUANT_INDIA_HOLIDAYS": "not-a-date",
+            }
+        )
+    with pytest.raises(ConfigurationError, match="timezone"):
+        load_settings(
+            {
+                "QUANT_INDIA_UNIVERSE_JSON": '{"symbols": []}',
+                "QUANT_INDIA_TIMEZONE": "Mars/Olympus_Mons",
+            }
+        )
+
+
+def test_threshold_dataclasses_reject_unsafe_values() -> None:
+    """Validation and retry thresholds cannot be disabled accidentally."""
+    with pytest.raises(ConfigurationError):
+        ValidationConfig(stale_after_hours=0)
+    with pytest.raises(ConfigurationError):
+        ValidationConfig(outlier_return_threshold=1)
+    with pytest.raises(ConfigurationError):
+        IngestionConfig(max_attempts=0)
+    assert StorageConfig().raw_root == StorageConfig().data_root / "raw"
