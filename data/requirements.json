{
  "datasets": [
    {
      "name": "EOD Adjusted OHLCV",
      "path_glob": "data/raw/eod2_data/NSE/*/*/*.parquet",
      "required_columns": ["date", "symbol", "close", "volume"],
      "must_not_contain": {"source": "mock"},
      "min_rows": 100000,
      "min_date": "2015-01-01"
    },
    {
      "name": "Nifty 100 PIT",
      "path_glob": "data/universe/nifty100-pit/nifty100.csv",
      "must_not_contain": {"symbol": "MOCK1"},
      "min_rows": 100
    },
    {
      "name": "Nifty 50 PIT",
      "path_glob": "data/universe/nifty50-pit/nifty50.csv",
      "must_not_contain": {"symbol": "MOCK1"},
      "min_rows": 50
    },
    {
      "name": "Nifty 500 PIT",
      "path_glob": "data/universe/nifty500-pit/nifty500.csv",
      "must_not_contain": {"symbol": "MOCK1"},
      "min_rows": 100
    }
  ]
}
